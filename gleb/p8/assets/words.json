    "role": "maxim",
    "id": "w149"
  },
  { "text": "На", "start": 78.185, "end": 78.415, "line": "l17", "role": "narrator", "id": "w150" },
  {
    "text": "завтрак",
    "start": 78.415,
    "end": 78.787,
    "line": "l17",
    "role": "narrator",
    "id": "w151"
  },
  {
    "text": "картошка",
    "start": 78.787,
    "end": 79.304,
    "line": "l17",
    "role": "narrator",
    "id": "w152"
  },
  { "text": "в", "start": 79.304, "end": 79.39, "line": "l17", "role": "narrator", "id": "w153" },
  {
    "text": "мундире,",
    "start": 79.39,
    "end": 79.906,
    "line": "l17",
    "role": "narrator",
    "id": "w154"
  },
  {
    "text": "хлеб",
    "start": 79.906,
    "end": 80.135,
    "line": "l17",
    "role": "narrator",
    "id": "w155"
  },
  { "text": "и", "start": 80.135, "end": 80.365, "line": "l17", "role": "narrator", "id": "w156" },
  {
    "text": "чай",
    "start": 80.365,
    "end": 80.594,
    "line": "l17",
    "role": "narrator",
    "id": "w157"
  },
  { "text": "с", "start": 80.594, "end": 80.68, "line": "l17", "role": "narrator", "id": "w158" },
  {
    "text": "вареньем.",
    "start": 80.68,
    "end": 81.197,
    "line": "l17",
    "role": "narrator",
    "id": "w159"
  },
  { "text": "Ешь.", "start": 81.497, "end": 81.731, "line": "l18", "role": "masha", "id": "w160" },
  { "text": "А", "start": 81.731, "end": 81.965, "line": "l18", "role": "masha", "id": "w161" },
  { "text": "то", "start": 81.965, "end": 82.737, "line": "l18", "role": "masha", "id": "w162" },
  {
    "text": "совсем",
    "start": 82.737,
    "end": 83.118,
    "line": "l18",
    "role": "masha",
    "id": "w163"
  },
  {
    "text": "исхудал,",
    "start": 83.118,
    "end": 83.645,
    "line": "l18",
    "role": "masha",
    "id": "w164"
  },
  {
    "text": "герой.",
    "start": 83.645,
    "end": 84.026,
    "line": "l18",
    "role": "masha",
    "id": "w165"
  },
  { "text": "Это", "start": 84.326, "end": 84.832, "line": "l19", "role": "maxim", "id": "w166" },
  { "text": "ты", "start": 84.832, "end": 85.143, "line": "l19", "role": "maxim", "id": "w167" },
  { "text": "меня", "start": 85.143, "end": 85.831, "line": "l19", "role": "maxim", "id": "w168" },
  {
    "text": "откормить",
    "start": 85.831,
    "end": 86.532,
    "line": "l19",
    "role": "maxim",
    "id": "w169"
  },
  {
    "text": "хочешь,",
    "start": 86.532,
    "end": 87.038,
    "line": "l19",
    "role": "maxim",
    "id": "w170"
  },
  { "text": "чтоб", "start": 87.038, "end": 87.35, "line": "l19", "role": "maxim", "id": "w171" },
  { "text": "я", "start": 87.35, "end": 87.661, "line": "l19", "role": "maxim", "id": "w172" },
  { "text": "из", "start": 87.661, "end": 88.094, "line": "l19", "role": "maxim", "id": "w173" },
  {
    "text": "кровати",
    "start": 88.094,
    "end": 88.794,
    "line": "l19",
    "role": "maxim",
    "id": "w174"
  },
  { "text": "не", "start": 88.794, "end": 89.106, "line": "l19", "role": "maxim", "id": "w175" },
  {
    "text": "вылезал.",
    "start": 89.106,
    "end": 89.806,
    "line": "l19",
    "role": "maxim",
    "id": "w176"
  },
  {
    "text": "Максим!",
    "start": 90.106,
    "end": 90.732,
    "line": "l20",
    "role": "masha",
    "id": "w177"
  },
  {
    "text": "Прекрати…",
    "start": 90.732,
    "end": 92.16,
    "line": "l20",
    "role": "masha",
    "id": "w178"
  },
  { "text": "Она", "start": 92.76, "end": 93.092, "line": "l21", "role": "narrator", "id": "w179" },
  {
    "text": "улыбнулась.",
    "start": 93.092,
    "end": 93.68,
    "line": "l21",
    "role": "narrator",
    "id": "w180"
  },
  { "text": "А", "start": 93.68, "end": 93.884, "line": "l21", "role": "narrator", "id": "w181" },
  {
    "text": "потом",
    "start": 93.884,
    "end": 94.216,
    "line": "l21",
    "role": "narrator",
    "id": "w182"
  },
  {
    "text": "посмотрела",
    "start": 94.216,
    "end": 94.804,
    "line": "l21",
    "role": "narrator",
    "id": "w183"
  },
  { "text": "на", "start": 94.804, "end": 95.008, "line": "l21", "role": "narrator", "id": "w184" },
  {
    "text": "фотографию",
    "start": 95.008,
    "end": 95.724,
    "line": "l21",
    "role": "narrator",
    "id": "w185"
  },
  { "text": "на", "start": 95.724, "end": 95.928, "line": "l21", "role": "narrator", "id": "w186" },
  {
    "text": "полке.",
    "start": 95.928,
    "end": 96.412,
    "line": "l21",
    "role": "narrator",
    "id": "w187"
  },
  {
    "text": "Глеб",
    "start": 96.412,
    "end": 96.616,
    "line": "l21",
    "role": "narrator",
    "id": "w188"
  },
  { "text": "и", "start": 96.616, "end": 96.82, "line": "l21", "role": "narrator", "id": "w189" },
  {
    "text": "мальчики.",
    "start": 96.82,
    "end": 97.28,
    "line": "l21",
    "role": "narrator",
    "id": "w190"
  },
  { "text": "Я", "start": 97.68, "end": 97.875, "line": "l22", "role": "masha", "id": "w191" },
  {
    "text": "видела",
    "start": 97.875,
    "end": 98.314,
    "line": "l22",
    "role": "masha",
    "id": "w192"
  },
  { "text": "их", "start": 98.314, "end": 98.509, "line": "l22", "role": "masha", "id": "w193" },
  { "text": "во", "start": 98.509, "end": 98.704, "line": "l22", "role": "masha", "id": "w194" },
  { "text": "сне.", "start": 98.704, "end": 98.899, "line": "l22", "role": "masha", "id": "w195" },
  { "text": "Они", "start": 98.899, "end": 99.485, "line": "l22", "role": "masha", "id": "w196" },
  { "text": "звали", "start": 99.485, "end": 99.802, "line": "l22", "role": "masha", "id": "w197" },
  {
    "text": "меня.",
    "start": 99.802,
    "end": 100.119,
    "line": "l22",
    "role": "masha",
    "id": "w198"
  },
  { "text": "Не", "start": 100.519, "end": 100.836, "line": "l23", "role": "maxim", "id": "w199" },
  {
    "text": "мучай",
    "start": 100.836,
    "end": 101.351,
    "line": "l23",
    "role": "maxim",
    "id": "w200"
  },
  {
    "text": "себя,",
    "start": 101.351,
    "end": 101.865,
    "line": "l23",
    "role": "maxim",
    "id": "w201"
  },
  {
    "text": "Маш.",
    "start": 101.865,
    "end": 102.484,
    "line": "l23",
    "role": "maxim",
    "id": "w202"
  },
  { "text": "Как", "start": 102.484, "end": 102.801, "line": "l23", "role": "maxim", "id": "w203" },
  {
    "text": "снег",
    "start": 102.801,
    "end": 103.118,
    "line": "l23",
    "role": "maxim",
    "id": "w204"
  },
  {
    "text": "сойдёт",
    "start": 103.118,
    "end": 103.633,
    "line": "l23",
    "role": "maxim",
    "id": "w205"
  },
  {
    "text": "поедем",
    "start": 103.633,
    "end": 104.346,
    "line": "l23",
    "role": "maxim",
    "id": "w206"
  },
  { "text": "в", "start": 104.346, "end": 104.465, "line": "l23", "role": "maxim", "id": "w207" },
  {
    "text": "город,",
    "start": 104.465,
    "end": 105.289,
    "line": "l23",
    "role": "maxim",
    "id": "w208"
  },
  {
    "text": "будем",
    "start": 105.289,
    "end": 105.803,
    "line": "l23",
    "role": "maxim",
    "id": "w209"
  },
  {
    "text": "искать.",
    "start": 105.803,
    "end": 106.318,
    "line": "l23",
    "role": "maxim",
    "id": "w210"
  },
  {
    "text": "Так.",
    "start": 106.918,
    "end": 107.239,
    "line": "l24",
    "role": "maxim",
    "id": "w211"
  },
  {
    "text": "Дров",
    "start": 107.239,
    "end": 107.989,
    "line": "l24",
    "role": "maxim",
    "id": "w212"
  },
  { "text": "на", "start": 107.989, "end": 108.31, "line": "l24", "role": "maxim", "id": "w213" },
  { "text": "два", "start": 108.31, "end": 108.631, "line": "l24", "role": "maxim", "id": "w214" },
  { "text": "дня", "start": 108.631, "end": 108.952, "line": "l24", "role": "maxim", "id": "w215" },
  {
    "text": "осталось.",
    "start": 108.952,
    "end": 109.673,
    "line": "l24",
    "role": "maxim",
    "id": "w216"
  },
  {
    "text": "Пойду",
    "start": 109.673,
    "end": 110.476,
    "line": "l24",
    "role": "maxim",
    "id": "w217"
  },
  { "text": "в", "start": 110.476, "end": 110.597, "line": "l24", "role": "maxim", "id": "w218" },
  {
    "text": "лес,",
    "start": 110.597,
    "end": 110.917,
    "line": "l24",
    "role": "maxim",
    "id": "w219"
  },
  {
    "text": "нарублю.",
    "start": 110.917,
    "end": 111.639,
    "line": "l24",
    "role": "maxim",
    "id": "w220"
  },
  {
    "text": "Далеко",
    "start": 111.939,
    "end": 112.439,
    "line": "l25",
    "role": "masha",
    "id": "w221"
  },
  { "text": "не", "start": 112.439, "end": 112.662, "line": "l25", "role": "masha", "id": "w222" },
  {
    "text": "ходи.",
    "start": 112.662,
    "end": 113.423,
    "line": "l25",
    "role": "masha",
    "id": "w223"
  },
  {
    "text": "Говорят,",
    "start": 113.423,
    "end": 113.923,
    "line": "l25",
    "role": "masha",
    "id": "w224"
  },
  { "text": "там", "start": 113.923, "end": 114.146, "line": "l25", "role": "masha", "id": "w225" },
  {
    "text": "волки.",
    "start": 114.146,
    "end": 114.507,
    "line": "l25",
    "role": "masha",
    "id": "w226"
  },
  {
    "text": "Волки!",
    "start": 114.807,
    "end": 115.793,
    "line": "l26",
    "role": "maxim",
    "id": "w227"
  },
  { "text": "Я", "start": 115.793, "end": 116.399, "line": "l26", "role": "maxim", "id": "w228" },
  {
    "text": "танк",
    "start": 116.399,
    "end": 117.604,
    "line": "l26",
    "role": "maxim",
    "id": "w229"
  },
  {
    "text": "угнал,",
    "start": 117.604,
    "end": 118.59,
    "line": "l26",
    "role": "maxim",
    "id": "w230"
  },
  {
    "text": "Машенька.",
    "start": 118.59,
    "end": 120.303,
    "line": "l26",
    "role": "maxim",
    "id": "w231"
  },
  { "text": "Что", "start": 120.303, "end": 120.91, "line": "l26", "role": "maxim", "id": "w232" },
  { "text": "мне", "start": 120.91, "end": 121.766, "line": "l26", "role": "maxim", "id": "w233" },
  {
    "text": "волки?",
    "start": 121.766,
    "end": 122.752,
    "line": "l26",
    "role": "maxim",
    "id": "w234"
  },
  {
    "text": "Лес",
    "start": 123.952,
    "end": 124.19,
    "line": "l27",
    "role": "narrator",
    "id": "w235"
  },
  {
    "text": "стоял",
    "start": 124.19,
    "end": 124.577,
    "line": "l27",
    "role": "narrator",
    "id": "w236"
  },
  {
    "text": "белый",
    "start": 124.577,
    "end": 124.964,
    "line": "l27",
    "role": "narrator",
    "id": "w237"
  },
  {
    "text": "и",
    "start": 124.964,
    "end": 125.202,
    "line": "l27",
    "role": "narrator",
    "id": "w238"
  },
  {
    "text": "тихий.",
    "start": 125.202,
    "end": 125.589,
    "line": "l27",
    "role": "narrator",
    "id": "w239"
  },
  { "text": "Эх,", "start": 126.189, "end": 126.609, "line": "l28", "role": "maxim", "id": "w240" },
  {
    "text": "хорошо!",
    "start": 126.609,
    "end": 127.863,
    "line": "l28",
    "role": "maxim",
    "id": "w241"
  },
  { "text": "Ну,", "start": 127.863, "end": 128.284, "line": "l28", "role": "maxim", "id": "w242" },
  {
    "text": "родимая…",
    "start": 128.284,
    "end": 129.818,
    "line": "l28",
    "role": "maxim",
    "id": "w243"
  },
  {
    "text": "Раз!",
    "start": 129.818,
    "end": 130.463,
    "line": "l28",
    "role": "maxim",
    "id": "w244"
  },
  {
    "text": "Два!",
    "start": 130.463,
    "end": 130.883,
    "line": "l28",
    "role": "maxim",
    "id": "w245"
  },
  { "text": "Ух…", "start": 131.883, "end": 132.248, "line": "l29", "role": "maxim", "id": "w246" },
  {
    "text": "Крепкая",
    "start": 132.248,
    "end": 133.411,
    "line": "l29",
    "role": "maxim",
    "id": "w247"
  },
  {
    "text": "берёза.",
    "start": 133.411,
    "end": 134.486,
    "line": "l29",
    "role": "maxim",
    "id": "w248"
  },
  { "text": "Как", "start": 134.486, "end": 134.85, "line": "l29", "role": "maxim", "id": "w249" },
  { "text": "я.", "start": 134.85, "end": 135.215, "line": "l29", "role": "maxim", "id": "w250" },
  {
    "text": "И",
    "start": 136.015,
    "end": 136.229,
    "line": "l30",
    "role": "narrator",
    "id": "w251"
  },
  {
    "text": "тут",
    "start": 136.229,
    "end": 136.442,
    "line": "l30",
    "role": "narrator",
    "id": "w252"
  },
  {
    "text": "Максим",
    "start": 136.442,
    "end": 136.79,
    "line": "l30",
    "role": "narrator",
    "id": "w253"
  },
  {
    "text": "заметил",
    "start": 136.79,
    "end": 137.271,
    "line": "l30",
    "role": "narrator",
    "id": "w254"
  },
  {
    "text": "на",
    "start": 137.271,
    "end": 137.485,
    "line": "l30",
    "role": "narrator",
    "id": "w255"
  },
  {
    "text": "снегу",
    "start": 137.485,
    "end": 137.833,
    "line": "l30",
    "role": "narrator",
    "id": "w256"
  },
  {
    "text": "следы.",
    "start": 137.833,
    "end": 138.373,
    "line": "l30",
    "role": "narrator",
    "id": "w257"
  },
  {
    "text": "Маленькие.",
    "start": 138.373,
    "end": 139.137,
    "line": "l30",
    "role": "narrator",
    "id": "w258"
  },
  {
    "text": "Детские.",
    "start": 139.137,
    "end": 139.618,
    "line": "l30",
    "role": "narrator",
    "id": "w259"
  },
  { "text": "Это", "start": 139.918, "end": 140.346, "line": "l31", "role": "maxim", "id": "w260" },
  { "text": "ещё", "start": 140.346, "end": 140.774, "line": "l31", "role": "maxim", "id": "w261" },
  { "text": "что", "start": 140.774, "end": 141.037, "line": "l31", "role": "maxim", "id": "w262" },
  {
    "text": "такое…",
    "start": 141.037,
    "end": 141.63,
    "line": "l31",
    "role": "maxim",
    "id": "w263"
  },
  {
    "text": "Следы",
    "start": 142.13,
    "end": 142.5,
    "line": "l32",
    "role": "narrator",
    "id": "w264"
  },
  {
    "text": "вели",
    "start": 142.5,
    "end": 142.87,
    "line": "l32",
    "role": "narrator",
    "id": "w265"
  },
  { "text": "в", "start": 142.87, "end": 142.956, "line": "l32", "role": "narrator", "id": "w266" },
  {
    "text": "чащу.",
    "start": 142.956,
    "end": 143.326,
    "line": "l32",
    "role": "narrator",
    "id": "w267"
  },
  {
    "text": "А",
    "start": 143.326,
    "end": 143.554,
    "line": "l32",
    "role": "narrator",
    "id": "w268"
  },
  {
    "text": "под",
    "start": 143.554,
    "end": 143.781,
    "line": "l32",
    "role": "narrator",
    "id": "w269"
  },
  {
    "text": "ёлкой",
    "start": 143.781,
    "end": 144.152,
    "line": "l32",
    "role": "narrator",
    "id": "w270"
  },
  {
    "text": "лежал",
    "start": 144.152,
    "end": 144.522,
    "line": "l32",
    "role": "narrator",
    "id": "w271"
  },
  {
    "text": "игрушечный",
    "start": 144.522,
    "end": 145.177,
    "line": "l32",
    "role": "narrator",
    "id": "w272"
  },
  {
    "text": "заяц.",
    "start": 145.177,
    "end": 145.547,
    "line": "l32",
    "role": "narrator",
    "id": "w273"
  },
  { "text": "Это", "start": 145.847, "end": 146.398, "line": "l33", "role": "maxim", "id": "w274" },
  { "text": "ж…", "start": 146.398, "end": 146.525, "line": "l33", "role": "maxim", "id": "w275" },
  { "text": "Это", "start": 146.525, "end": 147.526, "line": "l33", "role": "maxim", "id": "w276" },
  { "text": "ж", "start": 147.526, "end": 147.653, "line": "l33", "role": "maxim", "id": "w277" },
  {
    "text": "младшенького",
    "start": 147.653,
    "end": 148.627,
    "line": "l33",
    "role": "maxim",
    "id": "w278"
  },
  {
    "text": "заяц…",
    "start": 148.627,
    "end": 149.178,
    "line": "l33",
    "role": "maxim",
    "id": "w279"
  },
