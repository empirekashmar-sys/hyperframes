[
  { "text": "Глеб", "start": 2.2, "end": 2.448, "line": "l01", "role": "narrator", "id": "w0" },
  {
    "text": "медленно",
    "start": 2.448,
    "end": 3.007,
    "line": "l01",
    "role": "narrator",
    "id": "w1"
  },
  {
    "text": "обернулся.",
    "start": 3.007,
    "end": 3.721,
    "line": "l01",
    "role": "narrator",
    "id": "w2"
  },
  { "text": "Его", "start": 3.721, "end": 4.125, "line": "l01", "role": "narrator", "id": "w3" },
  { "text": "лицо", "start": 4.125, "end": 4.528, "line": "l01", "role": "narrator", "id": "w4" },
  { "text": "было", "start": 4.528, "end": 4.932, "line": "l01", "role": "narrator", "id": "w5" },
  {
    "text": "спокойным.",
    "start": 4.932,
    "end": 5.49,
    "line": "l01",
    "role": "narrator",
    "id": "w6"
  },
  { "text": "Слишком", "start": 5.49, "end": 5.894, "line": "l01", "role": "narrator", "id": "w7" },
  {
    "text": "спокойным.",
    "start": 5.894,
    "end": 6.453,
    "line": "l01",
    "role": "narrator",
    "id": "w8"
  },
  { "text": "Знаешь,", "start": 6.853, "end": 7.308, "line": "l02", "role": "gleb", "id": "w9" },
  { "text": "Маша…", "start": 7.308, "end": 7.763, "line": "l02", "role": "gleb", "id": "w10" },
  { "text": "А", "start": 7.763, "end": 8.529, "line": "l02", "role": "gleb", "id": "w11" },
  { "text": "я", "start": 8.529, "end": 8.809, "line": "l02", "role": "gleb", "id": "w12" },
  { "text": "ведь", "start": 8.809, "end": 9.089, "line": "l02", "role": "gleb", "id": "w13" },
  { "text": "всё", "start": 9.089, "end": 9.369, "line": "l02", "role": "gleb", "id": "w14" },
  { "text": "знал.", "start": 9.369, "end": 9.649, "line": "l02", "role": "gleb", "id": "w15" },
  { "text": "И", "start": 10.049, "end": 10.245, "line": "l03", "role": "narrator", "id": "w16" },
  {
    "text": "вдруг",
    "start": 10.245,
    "end": 10.44,
    "line": "l03",
    "role": "narrator",
    "id": "w17"
  },
  { "text": "он", "start": 10.44, "end": 10.635, "line": "l03", "role": "narrator", "id": "w18" },
  {
    "text": "выхватил",
    "start": 10.635,
    "end": 11.074,
    "line": "l03",
    "role": "narrator",
    "id": "w19"
  },
  {
    "text": "пистолет.",
    "start": 11.074,
    "end": 11.513,
    "line": "l03",
    "role": "narrator",
    "id": "w20"
  },
  {
    "text": "Выстрел.",
    "start": 11.913,
    "end": 12.322,
    "line": "l04",
    "role": "narrator",
    "id": "w21"
  },
  { "text": "Дед", "start": 12.322, "end": 12.573, "line": "l04", "role": "narrator", "id": "w22" },
  {
    "text": "Максим",
    "start": 12.573,
    "end": 12.981,
    "line": "l04",
    "role": "narrator",
    "id": "w23"
  },
  {
    "text": "рухнул",
    "start": 12.981,
    "end": 13.389,
    "line": "l04",
    "role": "narrator",
    "id": "w24"
  },
  { "text": "на", "start": 13.389, "end": 13.64, "line": "l04", "role": "narrator", "id": "w25" },
  {
    "text": "землю,",
    "start": 13.64,
    "end": 14.048,
    "line": "l04",
    "role": "narrator",
    "id": "w26"
  },
  {
    "text": "схватившись",
    "start": 14.048,
    "end": 14.613,
    "line": "l04",
    "role": "narrator",
    "id": "w27"
  },
  { "text": "за", "start": 14.613, "end": 14.865, "line": "l04", "role": "narrator", "id": "w28" },
  {
    "text": "ногу.",
    "start": 14.865,
    "end": 15.273,
    "line": "l04",
    "role": "narrator",
    "id": "w29"
  },
  { "text": "А-а-а!", "start": 16.273, "end": 17.384, "line": "l05", "role": "maxim", "id": "w30" },
  { "text": "Глеб!", "start": 17.384, "end": 17.787, "line": "l05", "role": "maxim", "id": "w31" },
  { "text": "Ты", "start": 17.787, "end": 18.559, "line": "l05", "role": "maxim", "id": "w32" },
  { "text": "что", "start": 18.559, "end": 18.962, "line": "l05", "role": "maxim", "id": "w33" },
  {
    "text": "творишь?!",
    "start": 18.962,
    "end": 19.617,
    "line": "l05",
    "role": "maxim",
    "id": "w34"
  },
  { "text": "Глеб!", "start": 19.917, "end": 20.826, "line": "l06", "role": "masha", "id": "w35" },
  { "text": "Нет!", "start": 20.826, "end": 21.331, "line": "l06", "role": "masha", "id": "w36" },
  {
    "text": "Глеб",
    "start": 21.931,
    "end": 22.174,
    "line": "l07",
    "role": "narrator",
    "id": "w37"
  },
  {
    "text": "скинул",
    "start": 22.174,
    "end": 22.57,
    "line": "l07",
    "role": "narrator",
    "id": "w38"
  },
  {
    "text": "кожаную",
    "start": 22.57,
    "end": 23.269,
    "line": "l07",
    "role": "narrator",
    "id": "w39"
  },
  {
    "text": "куртку.",
    "start": 23.269,
    "end": 23.664,
    "line": "l07",
    "role": "narrator",
    "id": "w40"
  },
  { "text": "Под", "start": 23.664, "end": 23.908, "line": "l07", "role": "narrator", "id": "w41" },
  { "text": "ней", "start": 23.908, "end": 24.151, "line": "l07", "role": "narrator", "id": "w42" },
  {
    "text": "обтягивающая",
    "start": 24.151,
    "end": 25.306,
    "line": "l07",
    "role": "narrator",
    "id": "w43"
  },
  {
    "text": "чёрная",
    "start": 25.306,
    "end": 25.854,
    "line": "l07",
    "role": "narrator",
    "id": "w44"
  },
  {
    "text": "футболка.",
    "start": 25.854,
    "end": 26.401,
    "line": "l07",
    "role": "narrator",
    "id": "w45"
  },
  { "text": "И", "start": 26.401, "end": 26.644, "line": "l07", "role": "narrator", "id": "w46" },
  {
    "text": "чёрный",
    "start": 26.644,
    "end": 27.04,
    "line": "l07",
    "role": "narrator",
    "id": "w47"
  },
  {
    "text": "бронежилет.",
    "start": 27.04,
    "end": 27.739,
    "line": "l07",
    "role": "narrator",
    "id": "w48"
  },
  { "text": "С", "start": 27.739, "end": 27.83, "line": "l07", "role": "narrator", "id": "w49" },
  {
    "text": "надписью",
    "start": 27.83,
    "end": 28.378,
    "line": "l07",
    "role": "narrator",
    "id": "w50"
  },
  {
    "text": "«ГУЛЬ».",
    "start": 28.378,
    "end": 28.621,
    "line": "l07",
    "role": "narrator",
    "id": "w51"
  },
  { "text": "Я", "start": 29.421, "end": 29.679, "line": "l08", "role": "gleb", "id": "w52" },
  { "text": "всё", "start": 29.679, "end": 29.936, "line": "l08", "role": "gleb", "id": "w53" },
  { "text": "это", "start": 29.936, "end": 30.355, "line": "l08", "role": "gleb", "id": "w54" },
  { "text": "знал.", "start": 30.355, "end": 30.938, "line": "l08", "role": "gleb", "id": "w55" },
  { "text": "Про", "start": 30.938, "end": 31.196, "line": "l08", "role": "gleb", "id": "w56" },
  { "text": "дачу.", "start": 31.196, "end": 31.793, "line": "l08", "role": "gleb", "id": "w57" },
  { "text": "Про", "start": 31.793, "end": 32.051, "line": "l08", "role": "gleb", "id": "w58" },
  { "text": "море.", "start": 32.051, "end": 32.743, "line": "l08", "role": "gleb", "id": "w59" },
  { "text": "Про", "start": 32.743, "end": 33.001, "line": "l08", "role": "gleb", "id": "w60" },
  { "text": "вас", "start": 33.001, "end": 33.259, "line": "l08", "role": "gleb", "id": "w61" },
  { "text": "двоих.", "start": 33.259, "end": 33.677, "line": "l08", "role": "gleb", "id": "w62" },
  { "text": "И", "start": 33.977, "end": 34.25, "line": "l09", "role": "gleb", "id": "w63" },
  { "text": "знаешь", "start": 34.25, "end": 34.693, "line": "l09", "role": "gleb", "id": "w64" },
  { "text": "что?", "start": 34.693, "end": 34.966, "line": "l09", "role": "gleb", "id": "w65" },
  { "text": "Детей", "start": 34.966, "end": 35.409, "line": "l09", "role": "gleb", "id": "w66" },
  { "text": "мне", "start": 35.409, "end": 35.682, "line": "l09", "role": "gleb", "id": "w67" },
  { "text": "не", "start": 35.682, "end": 35.955, "line": "l09", "role": "gleb", "id": "w68" },
  { "text": "жалко.", "start": 35.955, "end": 36.398, "line": "l09", "role": "gleb", "id": "w69" },
  { "text": "И", "start": 36.398, "end": 36.855, "line": "l09", "role": "gleb", "id": "w70" },
  { "text": "вас", "start": 36.855, "end": 37.127, "line": "l09", "role": "gleb", "id": "w71" },
  { "text": "мне", "start": 37.127, "end": 37.4, "line": "l09", "role": "gleb", "id": "w72" },
  { "text": "не", "start": 37.4, "end": 37.673, "line": "l09", "role": "gleb", "id": "w73" },
  { "text": "жалко.", "start": 37.673, "end": 38.116, "line": "l09", "role": "gleb", "id": "w74" },
  { "text": "Глеб…", "start": 38.716, "end": 39.054, "line": "l10", "role": "masha", "id": "w75" },
  { "text": "Кто", "start": 39.054, "end": 39.879, "line": "l10", "role": "masha", "id": "w76" },
  { "text": "ты", "start": 39.879, "end": 40.218, "line": "l10", "role": "masha", "id": "w77" },
  {
    "text": "такой?..",
    "start": 40.218,
    "end": 40.768,
    "line": "l10",
    "role": "masha",
    "id": "w78"
  },
  { "text": "В", "start": 41.368, "end": 41.461, "line": "l11", "role": "narrator", "id": "w79" },
  { "text": "его", "start": 41.461, "end": 41.868, "line": "l11", "role": "narrator", "id": "w80" },
  { "text": "ухе", "start": 41.868, "end": 42.274, "line": "l11", "role": "narrator", "id": "w81" },
  { "text": "тихо", "start": 42.274, "end": 42.68, "line": "l11", "role": "narrator", "id": "w82" },
  {
    "text": "щёлкнул",
    "start": 42.68,
    "end": 43.086,
    "line": "l11",
    "role": "narrator",
    "id": "w83"
  },
  {
    "text": "наушник.",
    "start": 43.086,
    "end": 43.649,
    "line": "l11",
    "role": "narrator",
    "id": "w84"
  },
  {
    "text": "Приём,",
    "start": 43.949,
    "end": 44.244,
    "line": "l12",
    "role": "valkyrie",
    "id": "w85"
  },
  {
    "text": "Гуль.",
    "start": 44.244,
    "end": 44.667,
    "line": "l12",
    "role": "valkyrie",
    "id": "w86"
  },
  { "text": "Это", "start": 44.667, "end": 45.311, "line": "l12", "role": "valkyrie", "id": "w87" },
  {
    "text": "Валькирия.",
    "start": 45.311,
    "end": 45.833,
    "line": "l12",
    "role": "valkyrie",
    "id": "w88"
  },
  { "text": "Что", "start": 45.833, "end": 46.944, "line": "l12", "role": "valkyrie", "id": "w89" },
  {
    "text": "делаем?",
    "start": 46.944,
    "end": 47.353,
    "line": "l12",
    "role": "valkyrie",
    "id": "w90"
  },
  { "text": "Принял.", "start": 47.653, "end": 48.522, "line": "l13", "role": "gleb", "id": "w91" },
  { "text": "Жди.", "start": 48.522, "end": 48.943, "line": "l13", "role": "gleb", "id": "w92" },
  { "text": "Ты", "start": 49.543, "end": 49.766, "line": "l14", "role": "gleb", "id": "w93" },
  { "text": "думала,", "start": 49.766, "end": 50.405, "line": "l14", "role": "gleb", "id": "w94" },
  { "text": "всё", "start": 50.405, "end": 50.629, "line": "l14", "role": "gleb", "id": "w95" },
  { "text": "это", "start": 50.629, "end": 50.992, "line": "l14", "role": "gleb", "id": "w96" },
  {
    "text": "началось",
    "start": 50.992,
    "end": 51.495,
    "line": "l14",
    "role": "gleb",
    "id": "w97"
  },
  { "text": "из-за", "start": 51.495, "end": 51.858, "line": "l14", "role": "gleb", "id": "w98" },
