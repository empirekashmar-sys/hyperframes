  { "text": "Нет,", "start": 52.477, "end": 52.7, "line": "l14", "role": "gleb", "id": "w100" },
  { "text": "Маша.", "start": 52.7, "end": 53.063, "line": "l14", "role": "gleb", "id": "w101" },
  { "text": "В", "start": 53.363, "end": 53.462, "line": "l15", "role": "gleb", "id": "w102" },
  { "text": "мире", "start": 53.462, "end": 53.887, "line": "l15", "role": "gleb", "id": "w103" },
  { "text": "вирус.", "start": 53.887, "end": 54.312, "line": "l15", "role": "gleb", "id": "w104" },
  { "text": "Он", "start": 54.312, "end": 54.574, "line": "l15", "role": "gleb", "id": "w105" },
  {
    "text": "превращает",
    "start": 54.574,
    "end": 55.594,
    "line": "l15",
    "role": "gleb",
    "id": "w106"
  },
  { "text": "людей", "start": 55.594, "end": 56.019, "line": "l15", "role": "gleb", "id": "w107" },
  { "text": "в", "start": 56.019, "end": 56.118, "line": "l15", "role": "gleb", "id": "w108" },
  { "text": "зомби.", "start": 56.118, "end": 56.543, "line": "l15", "role": "gleb", "id": "w109" },
  { "text": "А", "start": 56.543, "end": 57.125, "line": "l15", "role": "gleb", "id": "w110" },
  { "text": "война", "start": 57.125, "end": 57.551, "line": "l15", "role": "gleb", "id": "w111" },
  { "text": "просто", "start": 57.551, "end": 57.976, "line": "l15", "role": "gleb", "id": "w112" },
  {
    "text": "прикрытие.",
    "start": 57.976,
    "end": 58.729,
    "line": "l15",
    "role": "gleb",
    "id": "w113"
  },
  { "text": "Чтобы", "start": 58.729, "end": 59.276, "line": "l15", "role": "gleb", "id": "w114" },
  { "text": "никто", "start": 59.276, "end": 59.701, "line": "l15", "role": "gleb", "id": "w115" },
  { "text": "не", "start": 59.701, "end": 59.963, "line": "l15", "role": "gleb", "id": "w116" },
  {
    "text": "задавал",
    "start": 59.963,
    "end": 60.552,
    "line": "l15",
    "role": "gleb",
    "id": "w117"
  },
  {
    "text": "вопросов.",
    "start": 60.552,
    "end": 61.141,
    "line": "l15",
    "role": "gleb",
    "id": "w118"
  },
  {
    "text": "Глеб",
    "start": 61.941,
    "end": 62.188,
    "line": "l16",
    "role": "narrator",
    "id": "w119"
  },
  {
    "text": "достал",
    "start": 62.188,
    "end": 62.588,
    "line": "l16",
    "role": "narrator",
    "id": "w120"
  },
  {
    "text": "сигарету.",
    "start": 62.588,
    "end": 63.296,
    "line": "l16",
    "role": "narrator",
    "id": "w121"
  },
  {
    "text": "Закурил.",
    "start": 63.296,
    "end": 63.851,
    "line": "l16",
    "role": "narrator",
    "id": "w122"
  },
  { "text": "Я", "start": 64.851, "end": 65.081, "line": "l17", "role": "gleb", "id": "w123" },
  { "text": "всегда", "start": 65.081, "end": 65.454, "line": "l17", "role": "gleb", "id": "w124" },
  { "text": "был", "start": 65.454, "end": 65.683, "line": "l17", "role": "gleb", "id": "w125" },
  { "text": "предан", "start": 65.683, "end": 66.057, "line": "l17", "role": "gleb", "id": "w126" },
  { "text": "этим", "start": 66.057, "end": 66.43, "line": "l17", "role": "gleb", "id": "w127" },
  { "text": "людям.", "start": 66.43, "end": 66.803, "line": "l17", "role": "gleb", "id": "w128" },
  {
    "text": "Всегда.",
    "start": 66.803,
    "end": 67.458,
    "line": "l17",
    "role": "gleb",
    "id": "w129"
  },
  { "text": "Ещё", "start": 67.458, "end": 68.104, "line": "l17", "role": "gleb", "id": "w130" },
  { "text": "до", "start": 68.104, "end": 68.334, "line": "l17", "role": "gleb", "id": "w131" },
  { "text": "того,", "start": 68.334, "end": 68.707, "line": "l17", "role": "gleb", "id": "w132" },
  { "text": "как", "start": 68.707, "end": 68.936, "line": "l17", "role": "gleb", "id": "w133" },
  { "text": "мы", "start": 68.936, "end": 69.166, "line": "l17", "role": "gleb", "id": "w134" },
  { "text": "с", "start": 69.166, "end": 69.252, "line": "l17", "role": "gleb", "id": "w135" },
  { "text": "тобой", "start": 69.252, "end": 69.625, "line": "l17", "role": "gleb", "id": "w136" },
  {
    "text": "познакомились.",
    "start": 69.625,
    "end": 70.429,
    "line": "l17",
    "role": "gleb",
    "id": "w137"
  },
  { "text": "Так", "start": 70.929, "end": 71.334, "line": "l18", "role": "maxim", "id": "w138" },
  { "text": "ты…", "start": 71.334, "end": 72.004, "line": "l18", "role": "maxim", "id": "w139" },
  { "text": "Ты", "start": 72.004, "end": 72.409, "line": "l18", "role": "maxim", "id": "w140" },
  { "text": "всё", "start": 72.409, "end": 73.136, "line": "l18", "role": "maxim", "id": "w141" },
  { "text": "это", "start": 73.136, "end": 73.793, "line": "l18", "role": "maxim", "id": "w142" },
  { "text": "время…", "start": 73.793, "end": 74.45, "line": "l18", "role": "maxim", "id": "w143" },
  { "text": "Молчи,", "start": 74.75, "end": 75.123, "line": "l19", "role": "gleb", "id": "w144" },
  { "text": "дед.", "start": 75.123, "end": 75.353, "line": "l19", "role": "gleb", "id": "w145" },
  { "text": "Ты", "start": 75.353, "end": 75.583, "line": "l19", "role": "gleb", "id": "w146" },
