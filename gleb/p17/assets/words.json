    "end": 96.947,
    "line": "l22",
    "role": "narrator",
    "id": "w160"
  },
  {
    "text": "Петрович",
    "start": 96.947,
    "end": 97.449,
    "line": "l22",
    "role": "narrator",
    "id": "w161"
  },
