    "text": "Зина",
    "start": 118.665,
    "end": 119.076,
    "line": "l27",
    "role": "narrator",
    "id": "w200"
  },
  {
    "text": "огрела",
    "start": 119.076,
    "end": 119.644,
    "line": "l27",
    "role": "narrator",
    "id": "w201"
  },
