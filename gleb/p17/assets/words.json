    "text": "полками",
    "start": 34.072,
    "end": 34.583,
    "line": "l07",
    "role": "narrator",
    "id": "w53"
  },
  {
    "text": "что-то",
    "start": 34.583,
    "end": 34.952,
    "line": "l07",
    "role": "narrator",
    "id": "w54"
  },
  {
    "text": "шевельнулось.",
    "start": 34.952,
    "end": 35.604,
    "line": "l07",
    "role": "narrator",
    "id": "w55"
  },
  { "text": "Кто", "start": 36.004, "end": 36.653, "line": "l08", "role": "maxim", "id": "w56" },
  {
    "text": "здесь?..",
    "start": 36.653,
    "end": 37.301,
    "line": "l08",
    "role": "maxim",
    "id": "w57"
  },
  { "text": "Из", "start": 37.701, "end": 37.916, "line": "l09", "role": "narrator", "id": "w58" },
  {
    "text": "темноты",
    "start": 37.916,
    "end": 38.399,
    "line": "l09",
    "role": "narrator",
    "id": "w59"
  },
  {
    "text": "вышли",
    "start": 38.399,
    "end": 38.748,
    "line": "l09",
    "role": "narrator",
    "id": "w60"
  },
  {
    "text": "трое.",
    "start": 38.748,
    "end": 39.097,
    "line": "l09",
    "role": "narrator",
    "id": "w61"
  },
  { "text": "С", "start": 39.097, "end": 39.177, "line": "l09", "role": "narrator", "id": "w62" },
  {
    "text": "мутно-белыми",
    "start": 39.177,
    "end": 39.929,
    "line": "l09",
    "role": "narrator",
    "id": "w63"
  },
  {
    "text": "глазами.",
    "start": 39.929,
    "end": 40.412,
    "line": "l09",
    "role": "narrator",
    "id": "w64"
  },
  { "text": "Ну", "start": 40.712, "end": 41.078, "line": "l10", "role": "maxim", "id": "w65" },
