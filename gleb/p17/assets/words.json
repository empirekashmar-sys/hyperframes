    "end": 24.864,
    "line": "l05",
    "role": "narrator",
    "id": "w38"
  },
  {
    "text": "было",
    "start": 24.864,
    "end": 25.259,
    "line": "l05",
    "role": "narrator",
    "id": "w39"
  },
  {
    "text": "темно.",
    "start": 25.259,
    "end": 25.655,
    "line": "l05",
    "role": "narrator",
    "id": "w40"
  },
  {
    "text": "Пахло",
    "start": 25.655,
    "end": 26.051,
    "line": "l05",
    "role": "narrator",
    "id": "w41"
  },
  {
    "text": "пылью",
    "start": 26.051,
    "end": 26.446,
    "line": "l05",
    "role": "narrator",
    "id": "w42"
  },
  { "text": "и", "start": 26.446, "end": 26.69, "line": "l05", "role": "narrator", "id": "w43" },
  {
    "text": "чем-то",
    "start": 26.69,
    "end": 27.085,
    "line": "l05",
    "role": "narrator",
    "id": "w44"
  },
  {
    "text": "кислым.",
    "start": 27.085,
    "end": 27.481,
    "line": "l05",
    "role": "narrator",
    "id": "w45"
  },
  {
    "text": "Тушёнка…",
    "start": 27.881,
    "end": 28.761,
    "line": "l06",
    "role": "maxim",
    "id": "w46"
  },
  { "text": "Вода…", "start": 28.761, "end": 29.718, "line": "l06", "role": "maxim", "id": "w47" },
  { "text": "О,", "start": 29.718, "end": 30.394, "line": "l06", "role": "maxim", "id": "w48" },
  {
    "text": "сгущёнка!",
    "start": 30.394,
    "end": 31.275,
    "line": "l06",
    "role": "maxim",
    "id": "w49"
  },
  { "text": "Маше", "start": 31.275, "end": 32.12, "line": "l06", "role": "maxim", "id": "w50" },
  {
    "text": "понравится…",
    "start": 32.12,
    "end": 33.245,
    "line": "l06",
    "role": "maxim",
    "id": "w51"
  },
  { "text": "За", "start": 33.845, "end": 34.072, "line": "l07", "role": "narrator", "id": "w52" },
