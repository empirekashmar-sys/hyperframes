    "text": "Максима.",
    "start": 110.594,
    "end": 111.103,
    "line": "l25",
    "role": "masha",
    "id": "w187"
  },
  {
    "text": "Что?!",
    "start": 111.403,
    "end": 111.717,
    "line": "l26",
    "role": "zina",
    "id": "w188"
  },
  { "text": "Ах", "start": 111.717, "end": 112.03, "line": "l26", "role": "zina", "id": "w189" },
  { "text": "ты", "start": 112.03, "end": 113.154, "line": "l26", "role": "zina", "id": "w190" },
  {
    "text": "старый",
    "start": 113.154,
    "end": 113.663,
    "line": "l26",
    "role": "zina",
    "id": "w191"
  },
  {
    "text": "кобель!",
    "start": 113.663,
    "end": 114.173,
    "line": "l26",
    "role": "zina",
    "id": "w192"
  },
  { "text": "Сорок", "start": 114.173, "end": 115.31, "line": "l26", "role": "zina", "id": "w193" },
  { "text": "лет", "start": 115.31, "end": 115.623, "line": "l26", "role": "zina", "id": "w194" },
  { "text": "мне", "start": 115.623, "end": 115.937, "line": "l26", "role": "zina", "id": "w195" },
  {
    "text": "голову",
    "start": 115.937,
    "end": 116.642,
    "line": "l26",
    "role": "zina",
    "id": "w196"
  },
  {
    "text": "морочил",
    "start": 116.642,
    "end": 117.347,
    "line": "l26",
    "role": "zina",
    "id": "w197"
  },
  { "text": "а", "start": 117.347, "end": 118.051, "line": "l26", "role": "zina", "id": "w198" },
  { "text": "тут!", "start": 118.051, "end": 118.365, "line": "l26", "role": "zina", "id": "w199" },
