    "text": "живот?",
    "start": 102.663,
    "end": 103.003,
    "line": "l23",
    "role": "zina",
    "id": "w172"
  },
  { "text": "И", "start": 103.003, "end": 104.152, "line": "l23", "role": "zina", "id": "w173" },
  {
    "text": "почему",
    "start": 104.152,
    "end": 104.623,
    "line": "l23",
    "role": "zina",
    "id": "w174"
  },
  { "text": "ты", "start": 104.623, "end": 104.833, "line": "l23", "role": "zina", "id": "w175" },
  { "text": "на", "start": 104.833, "end": 105.042, "line": "l23", "role": "zina", "id": "w176" },
  { "text": "неё", "start": 105.042, "end": 105.382, "line": "l23", "role": "zina", "id": "w177" },
  { "text": "так", "start": 105.382, "end": 105.592, "line": "l23", "role": "zina", "id": "w178" },
