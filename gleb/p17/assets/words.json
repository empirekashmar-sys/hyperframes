    "text": "лаборатория.",
    "start": 150.881,
    "end": 152.133,
    "line": "l34",
    "role": "soldier1",
    "id": "w254"
  },
  {
    "text": "«Улей».",
    "start": 152.133,
    "end": 152.798,
    "line": "l34",
    "role": "soldier1",
    "id": "w255"
  },
  {
    "text": "Оттуда",
    "start": 152.798,
    "end": 153.287,
    "line": "l34",
    "role": "soldier1",
    "id": "w256"
  },
  {
    "text": "никто",
    "start": 153.287,
    "end": 153.641,
    "line": "l34",
    "role": "soldier1",
    "id": "w257"
  },
  {
    "text": "не",
    "start": 153.641,
    "end": 153.859,
    "line": "l34",
    "role": "soldier1",
    "id": "w258"
  },
