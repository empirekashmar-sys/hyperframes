    "text": "Зина?!",
    "start": 63.107,
    "end": 63.877,
    "line": "l16",
    "role": "maxim",
    "id": "w110"
  },
  {
    "text": "Зинка!",
    "start": 63.877,
    "end": 64.944,
    "line": "l16",
    "role": "maxim",
    "id": "w111"
  },
  {
    "text": "Живая!",
    "start": 64.944,
    "end": 66.324,
    "line": "l16",
    "role": "maxim",
    "id": "w112"
  },
  { "text": "Живая,", "start": 66.624, "end": 67.403, "line": "l17", "role": "zina", "id": "w113" },
  { "text": "живая!", "start": 67.403, "end": 68.182, "line": "l17", "role": "zina", "id": "w114" },
  {
    "text": "Залезай",
    "start": 68.182,
    "end": 69.291,
    "line": "l17",
    "role": "zina",
    "id": "w115"
  },
  {
    "text": "быстрее,",
    "start": 69.291,
    "end": 70.07,
    "line": "l17",
    "role": "zina",
    "id": "w116"
  },
  { "text": "чего", "start": 70.07, "end": 70.633, "line": "l17", "role": "zina", "id": "w117" },
  { "text": "встал", "start": 70.633, "end": 70.979, "line": "l17", "role": "zina", "id": "w118" },
  { "text": "как", "start": 70.979, "end": 71.326, "line": "l17", "role": "zina", "id": "w119" },
  {
    "text": "памятник!",
    "start": 71.326,
    "end": 72.277,
    "line": "l17",
    "role": "zina",
    "id": "w120"
  },
  { "text": "В", "start": 73.077, "end": 73.164, "line": "l18", "role": "narrator", "id": "w121" },
