    "start": 85.573,
    "end": 86.352,
    "line": "l19",
    "role": "zina",
    "id": "w145"
  },
  {
    "text": "Максим.",
    "start": 86.352,
    "end": 86.793,
    "line": "l19",
    "role": "zina",
    "id": "w146"
  },
