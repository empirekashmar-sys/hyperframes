    "text": "сердце,",
    "start": 128.542,
    "end": 129.063,
    "line": "l29",
    "role": "zina",
    "id": "w218"
  },
  {
    "text": "Максим!",
    "start": 129.063,
    "end": 129.991,
    "line": "l29",
    "role": "zina",
    "id": "w219"
  },
  {
    "text": "Сердце!",
    "start": 129.991,
    "end": 130.512,
    "line": "l29",
    "role": "zina",
    "id": "w220"
  },
  {
    "text": "Ладно…",
    "start": 131.112,
    "end": 131.545,
    "line": "l30",
    "role": "zina",
    "id": "w221"
  },
