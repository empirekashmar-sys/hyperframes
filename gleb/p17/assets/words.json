  { "text": "меня", "start": 125.61, "end": 126.481, "line": "l28", "role": "maxim", "id": "w213" },
  {
    "text": "нога!",
    "start": 126.481,
    "end": 127.081,
    "line": "l28",
    "role": "maxim",
    "id": "w214"
  },
  { "text": "А", "start": 127.381, "end": 127.701, "line": "l29", "role": "zina", "id": "w215" },
  { "text": "у", "start": 127.701, "end": 128.021, "line": "l29", "role": "zina", "id": "w216" },
  { "text": "меня", "start": 128.021, "end": 128.542, "line": "l29", "role": "zina", "id": "w217" },
