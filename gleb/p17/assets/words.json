    "text": "говорил",
    "start": 138.1,
    "end": 138.654,
    "line": "l31",
    "role": "soldier1",
    "id": "w230"
  },
  {
    "text": "Гуль?",
    "start": 138.654,
    "end": 138.899,
    "line": "l31",
    "role": "soldier1",
    "id": "w231"
  },
  {
    "text": "Чёрный",
    "start": 138.899,
    "end": 139.729,
    "line": "l31",
    "role": "soldier1",
    "id": "w232"
  },
  {
    "text": "вертолёт?",
    "start": 139.729,
    "end": 140.282,
    "line": "l31",
    "role": "soldier1",
    "id": "w233"
  },
  {
    "text": "Говорил.",
    "start": 140.582,
    "end": 141.217,
    "line": "l32",
    "role": "maxim",
    "id": "w234"
  },
  { "text": "Ты", "start": 141.217, "end": 142.09, "line": "l32", "role": "maxim", "id": "w235" },
  { "text": "его", "start": 142.09, "end": 142.549, "line": "l32", "role": "maxim", "id": "w236" },
  {
    "text": "видел?",
    "start": 142.549,
    "end": 143.007,
    "line": "l32",
    "role": "maxim",
    "id": "w237"
  },
  {
    "text": "Видел.",
    "start": 143.307,
    "end": 143.675,
    "line": "l33",
    "role": "soldier1",
    "id": "w238"
  },
  {
    "text": "Они",
    "start": 143.675,
    "end": 144.253,
    "line": "l33",
    "role": "soldier1",
    "id": "w239"
  },
  {
    "text": "людей",
    "start": 144.253,
    "end": 144.621,
    "line": "l33",
    "role": "soldier1",
    "id": "w240"
  },
  {
    "text": "с",
    "start": 144.621,
    "end": 144.706,
    "line": "l33",
    "role": "soldier1",
    "id": "w241"
  },
  {
    "text": "лагерей",
    "start": 144.706,
    "end": 145.215,
    "line": "l33",
    "role": "soldier1",
    "id": "w242"
  },
  {
    "text": "забирают.",
    "start": 145.215,
    "end": 146.343,
    "line": "l33",
    "role": "soldier1",
    "id": "w243"
  },
  {
    "text": "Заражённых",
    "start": 146.343,
    "end": 146.994,
    "line": "l33",
    "role": "soldier1",
    "id": "w244"
  },
  { "text": "и", "start": 146.994, "end": 147.22, "line": "l33", "role": "soldier1", "id": "w245" },
  {
    "text": "здоровых.",
    "start": 147.22,
    "end": 148.019,
    "line": "l33",
    "role": "soldier1",
    "id": "w246"
  },
  {
    "text": "Везут",
    "start": 148.019,
    "end": 148.387,
    "line": "l33",
    "role": "soldier1",
    "id": "w247"
  },
  {
    "text": "на",
    "start": 148.387,
    "end": 148.614,
    "line": "l33",
    "role": "soldier1",
    "id": "w248"
  },
  {
    "text": "север.",
    "start": 148.614,
    "end": 149.259,
    "line": "l33",
    "role": "soldier1",
    "id": "w249"
  },
  {
    "text": "На",
    "start": 149.259,
    "end": 149.486,
    "line": "l33",
    "role": "soldier1",
    "id": "w250"
  },
  {
    "text": "старый",
    "start": 149.486,
    "end": 149.854,
    "line": "l33",
    "role": "soldier1",
    "id": "w251"
  },
  {
    "text": "химзавод.",
    "start": 149.854,
    "end": 150.363,
    "line": "l33",
    "role": "soldier1",
    "id": "w252"
  },
