  { "text": "не", "start": 42.422, "end": 42.787, "line": "l10", "role": "maxim", "id": "w68" },
  {
    "text": "сейчас…",
    "start": 42.787,
    "end": 43.382,
    "line": "l10",
    "role": "maxim",
    "id": "w69"
  },
  {
    "text": "Автомат",
    "start": 43.782,
    "end": 44.292,
    "line": "l11",
    "role": "narrator",
    "id": "w70"
  },
