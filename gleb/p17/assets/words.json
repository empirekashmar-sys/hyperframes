    "text": "Значит,",
    "start": 155.605,
    "end": 156.651,
    "line": "l35",
    "role": "maxim",
    "id": "w261"
  },
  {
    "text": "туда",
    "start": 156.651,
    "end": 157.235,
    "line": "l35",
    "role": "maxim",
    "id": "w262"
