  { "text": "это", "start": 87.617, "end": 88.648, "line": "l20", "role": "maxim", "id": "w148" },
  {
    "text": "женщина!",
    "start": 88.648,
    "end": 89.827,
    "line": "l20",
    "role": "maxim",
    "id": "w149"
  },
  { "text": "Зина,", "start": 90.227, "end": 90.813, "line": "l21", "role": "maxim", "id": "w150" },
  { "text": "там", "start": 90.813, "end": 91.483, "line": "l21", "role": "maxim", "id": "w151" },
  { "text": "Маша!", "start": 91.483, "end": 92.068, "line": "l21", "role": "maxim", "id": "w152" },
  { "text": "В", "start": 92.068, "end": 92.427, "line": "l21", "role": "maxim", "id": "w153" },
  {
    "text": "машине!",
    "start": 92.427,
    "end": 93.237,
    "line": "l21",
    "role": "maxim",
    "id": "w154"
  },
  {
    "text": "Раненая!",
    "start": 93.237,
    "end": 94.531,
    "line": "l21",
    "role": "maxim",
    "id": "w155"
  },
  {
    "text": "Машу",
    "start": 95.131,
    "end": 95.494,
    "line": "l22",
    "role": "narrator",
    "id": "w156"
  },
  {
    "text": "перенесли",
    "start": 95.494,
    "end": 96.137,
    "line": "l22",
    "role": "narrator",
    "id": "w157"
  },
  { "text": "в", "start": 96.137, "end": 96.22, "line": "l22", "role": "narrator", "id": "w158" },
  {
    "text": "автобус.",
    "start": 96.22,
    "end": 96.723,
    "line": "l22",
    "role": "narrator",
    "id": "w159"
  },
  {
    "text": "Кот",
