    "text": "кончились",
    "start": 45.664,
    "end": 46.175,
    "line": "l11",
    "role": "narrator",
    "id": "w74"
  },
  { "text": "ещё", "start": 46.175, "end": 46.544, "line": "l11", "role": "narrator", "id": "w75" },
  { "text": "в", "start": 46.544, "end": 46.629, "line": "l11", "role": "narrator", "id": "w76" },
  {
    "text": "лагере.",
    "start": 46.629,
    "end": 47.139,
    "line": "l11",
    "role": "narrator",
    "id": "w77"
  },
  { "text": "Ёб", "start": 47.439, "end": 47.848, "line": "l12", "role": "maxim", "id": "w78" },
  { "text": "твою", "start": 47.848, "end": 48.513, "line": "l12", "role": "maxim", "id": "w79" },
  { "text": "мать…", "start": 48.513, "end": 48.922, "line": "l12", "role": "maxim", "id": "w80" },
  { "text": "И", "start": 49.922, "end": 50.191, "line": "l13", "role": "narrator", "id": "w81" },
