    "start": 105.592,
    "end": 105.932,
    "line": "l23",
    "role": "zina",
    "id": "w179"
  },
  {
    "text": "Зин…",
    "start": 106.232,
    "end": 106.542,
    "line": "l24",
    "role": "maxim",
    "id": "w180"
  },
  { "text": "Тут", "start": 106.542, "end": 107.479, "line": "l24", "role": "maxim", "id": "w181" },
