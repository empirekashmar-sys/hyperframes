  { "text": "минут.", "start": 20.657, "end": 21.677, "line": "l04", "role": "maxim", "id": "w35" },
  {
    "text": "Петрович,",
    "start": 21.677,
    "end": 22.802,
    "line": "l04",
    "role": "maxim",
    "id": "w36"
