  {
    "text": "нечисть!",
    "start": 60.222,
    "end": 60.73,
    "line": "l15",
    "role": "zina",
    "id": "w106"
  },
  { "text": "Это", "start": 60.73, "end": 61.987, "line": "l15", "role": "zina", "id": "w107" },
