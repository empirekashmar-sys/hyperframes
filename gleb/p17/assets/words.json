    "start": 76.942,
    "end": 77.317,
    "line": "l18",
    "role": "narrator",
    "id": "w129"
  },
  {
    "text": "девочка",
    "start": 77.317,
    "end": 77.836,
    "line": "l18",
    "role": "narrator",
    "id": "w130"
  },
