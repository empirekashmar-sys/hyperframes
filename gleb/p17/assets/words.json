    "text": "почему",
    "start": 100.615,
    "end": 102.113,
    "line": "l23",
    "role": "zina",
    "id": "w169"
  },
  { "text": "у", "start": 102.113, "end": 102.323, "line": "l23", "role": "zina", "id": "w170" },
  { "text": "неё", "start": 102.323, "end": 102.663, "line": "l23", "role": "zina", "id": "w171" },
