  {
    "text": "зачем",
    "start": 116.657,
    "end": 117.007,
    "line": "l30",
    "role": "masha",
    "id": "w234"
  },
  {
    "text": "приходил?",
    "start": 117.007,
    "end": 117.492,
    "line": "l30",
    "role": "masha",
    "id": "w235"
  },
  { "text": "В", "start": 117.842, "end": 117.93, "line": "l31", "role": "gleb", "id": "w236" },
  {
    "text": "прошлый",
    "start": 117.93,
    "end": 118.313,
    "line": "l31",
    "role": "gleb",
    "id": "w237"
  },
  { "text": "раз", "start": 118.313, "end": 118.548, "line": "l31", "role": "gleb", "id": "w238" },
  { "text": "я", "start": 118.548, "end": 118.783, "line": "l31", "role": "gleb", "id": "w239" },
  {
    "text": "ничего",
    "start": 118.783,
    "end": 119.313,
    "line": "l31",
    "role": "gleb",
    "id": "w240"
  },
