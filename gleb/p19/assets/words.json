    "text": "говорил.",
    "start": 119.548,
    "end": 120.364,
    "line": "l31",
    "role": "gleb",
    "id": "w242"
  },
  { "text": "Я", "start": 120.364, "end": 120.599, "line": "l31", "role": "gleb", "id": "w243" },
