    "role": "gleb",
    "id": "w264"
  },
  {
    "text": "свой.",
    "start": 132.047,
    "end": 132.299,
    "line": "l35",
    "role": "gleb",
    "id": "w265"
  },
  { "text": "Из", "start": 132.299, "end": 132.906, "line": "l35", "role": "gleb", "id": "w266" },
