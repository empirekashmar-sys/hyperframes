    "text": "Отставить!",
    "start": 126.467,
    "end": 127.018,
    "line": "l33",
    "role": "gleb",
    "id": "w253"
  },
  {
    "text": "Никто",
    "start": 127.018,
    "end": 127.576,
    "line": "l33",
    "role": "gleb",
    "id": "w254"
  },
  {
    "text": "никого",
    "start": 127.576,
    "end": 128.127,
    "line": "l33",
    "role": "gleb",
    "id": "w255"
  },
  { "text": "не", "start": 128.127, "end": 128.372, "line": "l33", "role": "gleb", "id": "w256" },
  {
    "text": "берёт!",
    "start": 128.372,
    "end": 128.771,
    "line": "l33",
    "role": "gleb",
    "id": "w257"
  },
  {
    "text": "Ты",
    "start": 129.121,
    "end": 129.291,
    "line": "l34",
    "role": "valkyrie",
    "id": "w258"
  },
  {
    "text": "нарушаешь",
    "start": 129.291,
    "end": 129.782,
    "line": "l34",
    "role": "valkyrie",
    "id": "w259"
  },
  {
    "text": "приказ",
    "start": 129.782,
    "end": 130.059,
    "line": "l34",
    "role": "valkyrie",
    "id": "w260"
  },
  {
    "text": "генерала,",
    "start": 130.059,
    "end": 130.55,
    "line": "l34",
    "role": "valkyrie",
    "id": "w261"
  },
