    "text": "Прости",
    "start": 121.663,
    "end": 122.045,
    "line": "l31",
    "role": "gleb",
    "id": "w246"
  },
  {
    "text": "меня.",
    "start": 122.045,
    "end": 122.427,
    "line": "l31",
    "role": "gleb",
    "id": "w247"
  },
