    "text": "женщину.",
    "start": 125.021,
    "end": 125.74,
    "line": "l32",
    "role": "valkyrie",
    "id": "w251"
  },
  {
    "text": "Живой.",
    "start": 125.74,
    "end": 126.117,
    "line": "l32",
    "role": "valkyrie",
    "id": "w252"
  },
