    "text": "возвращаются",
    "start": 133.473,
    "end": 134.356,
    "line": "l35",
    "role": "gleb",
    "id": "w268"
  },
  { "text": "все.", "start": 134.356, "end": 134.608, "line": "l35", "role": "gleb", "id": "w269" },
  { "text": "И", "start": 134.608, "end": 135.115, "line": "l35", "role": "gleb", "id": "w270" },
  { "text": "они", "start": 135.115, "end": 135.741, "line": "l35", "role": "gleb", "id": "w271" },
  { "text": "тоже.", "start": 135.741, "end": 136.15, "line": "l35", "role": "gleb", "id": "w272" },
  {
    "text": "Двенадцать",
    "start": 136.55,
    "end": 137.032,
    "line": "l36",
    "role": "narrator",
    "id": "w273"
  },
  {
    "text": "резервных",
    "start": 137.032,
    "end": 137.514,
    "line": "l36",
    "role": "narrator",
    "id": "w274"
  },
  {
    "text": "подняли",
    "start": 137.514,
    "end": 137.997,
    "line": "l36",
    "role": "narrator",
    "id": "w275"
  },
  {
    "text": "автоматы.",
    "start": 137.997,
    "end": 138.613,
    "line": "l36",
    "role": "narrator",
    "id": "w276"
  },
  {
    "text": "Только",
    "start": 138.613,
    "end": 138.961,
    "line": "l36",
    "role": "narrator",
    "id": "w277"
  },
  {
    "text": "было",
    "start": 138.961,
    "end": 139.309,
    "line": "l36",
    "role": "narrator",
    "id": "w278"
  },
  {
    "text": "непонятно",
    "start": 139.309,
    "end": 139.925,
    "line": "l36",
    "role": "narrator",
    "id": "w279"
  },
  {
    "text": "на",
    "start": 139.925,
    "end": 140.139,
    "line": "l36",
    "role": "narrator",
    "id": "w280"
  },
  {
    "text": "кого.",
    "start": 140.139,
    "end": 140.487,
    "line": "l36",
    "role": "narrator",
    "id": "w281"
  },
  {
    "text": "Командир!",
    "start": 141.287,
    "end": 142.744,
    "line": "l37",
    "role": "fox",
    "id": "w282"
  },
  {
    "text": "Степь!",
    "start": 142.744,
    "end": 143.258,
    "line": "l37",
    "role": "fox",
    "id": "w283"
  },
  {
    "text": "Из-за",
    "start": 143.608,
    "end": 143.962,
    "line": "l38",
    "role": "narrator",
    "id": "w284"
  },
  {
    "text": "холма",
    "start": 143.962,
    "end": 144.315,
    "line": "l38",
    "role": "narrator",
    "id": "w285"
  },
  {
    "text": "поднималась",
    "start": 144.315,
    "end": 144.94,
    "line": "l38",
    "role": "narrator",
    "id": "w286"
  },
  {
    "text": "пыль.",
    "start": 144.94,
    "end": 145.158,
    "line": "l38",
    "role": "narrator",
    "id": "w287"
  },
  {
    "text": "Шум",
    "start": 145.158,
    "end": 145.375,
    "line": "l38",
    "role": "narrator",
    "id": "w288"
  },
  {
    "text": "вертолётов",
    "start": 145.375,
    "end": 146.0,
    "line": "l38",
    "role": "narrator",
    "id": "w289"
  },
  {
    "text": "разбудил",
    "start": 146.0,
    "end": 146.49,
    "line": "l38",
    "role": "narrator",
    "id": "w290"
  },
  {
    "text": "орду.",
    "start": 146.49,
    "end": 146.843,
    "line": "l38",
    "role": "narrator",
    "id": "w291"
  },
  {
    "text": "Сотни",
    "start": 146.843,
    "end": 147.196,
    "line": "l38",
    "role": "narrator",
    "id": "w292"
  },
  {
    "text": "заражённых",
    "start": 147.196,
    "end": 147.822,
    "line": "l38",
    "role": "narrator",
    "id": "w293"
  },
  {
    "text": "бежали",
    "start": 147.822,
    "end": 148.311,
    "line": "l38",
    "role": "narrator",
    "id": "w294"
  },
  {
    "text": "прямо",
    "start": 148.311,
    "end": 148.664,
    "line": "l38",
    "role": "narrator",
    "id": "w295"
  },
  {
    "text": "к",
    "start": 148.664,
    "end": 148.746,
    "line": "l38",
    "role": "narrator",
    "id": "w296"
  },
  {
    "text": "заправке.",
    "start": 148.746,
    "end": 149.235,
    "line": "l38",
    "role": "narrator",
    "id": "w297"
  },
  { "text": "Ну", "start": 149.835, "end": 150.142, "line": "l39", "role": "maxim", "id": "w298" },
  {
    "text": "что,",
    "start": 150.142,
    "end": 150.449,
    "line": "l39",
    "role": "maxim",
    "id": "w299"
  },
  {
    "text": "командир!",
    "start": 150.449,
    "end": 151.14,
    "line": "l39",
    "role": "maxim",
    "id": "w300"
  },
  {
    "text": "Мириться",
    "start": 151.14,
    "end": 152.181,
    "line": "l39",
    "role": "maxim",
    "id": "w301"
  },
  {
    "text": "будем",
    "start": 152.181,
    "end": 152.68,
    "line": "l39",
    "role": "maxim",
    "id": "w302"
  },
  {
    "text": "потом?",
    "start": 152.68,
    "end": 153.178,
    "line": "l39",
    "role": "maxim",
    "id": "w303"
  },
  {
    "text": "Потом!",
    "start": 153.528,
    "end": 154.284,
    "line": "l40",
    "role": "gleb",
    "id": "w304"
  },
  {
    "text": "«Омега»,",
    "start": 154.284,
    "end": 155.202,
    "line": "l40",
    "role": "gleb",
    "id": "w305"
  },
  { "text": "к", "start": 155.202, "end": 155.331, "line": "l40", "role": "gleb", "id": "w306" },
  { "text": "бою!", "start": 155.331, "end": 156.058, "line": "l40", "role": "gleb", "id": "w307" },
  { "text": "Все", "start": 156.058, "end": 156.402, "line": "l40", "role": "gleb", "id": "w308" },
  { "text": "к", "start": 156.402, "end": 156.532, "line": "l40", "role": "gleb", "id": "w309" },
  { "text": "бою!", "start": 156.532, "end": 157.091, "line": "l40", "role": "gleb", "id": "w310" },
  { "text": "Ну,", "start": 157.441, "end": 158.368, "line": "l41", "role": "zina", "id": "w311" },
  {
    "text": "нечисть,",
    "start": 158.368,
    "end": 159.416,
    "line": "l41",
    "role": "zina",
    "id": "w312"
  },
  {
    "text": "держись!",
    "start": 159.416,
    "end": 160.142,
    "line": "l41",
