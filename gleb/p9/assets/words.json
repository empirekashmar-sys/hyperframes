    "start": 106.322,
    "end": 106.625,
    "line": "l26",
    "role": "masha",
    "id": "w196"
  },
  {
    "text": "Маша…",
    "start": 106.925,
    "end": 107.505,
    "line": "l27",
    "role": "maxim",
    "id": "w197"
  },
  { "text": "Я", "start": 107.505, "end": 107.862, "line": "l27", "role": "maxim", "id": "w198" },
