    "text": "лесу",
    "start": 108.899,
    "end": 109.479,
    "line": "l27",
    "role": "maxim",
    "id": "w201"
  },
  {
    "text": "нашёл.",
    "start": 109.479,
    "end": 110.411,
    "line": "l27",
    "role": "maxim",
    "id": "w202"
  },
