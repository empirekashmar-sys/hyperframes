    "start": 117.411,
    "end": 118.085,
    "line": "l29",
    "role": "maxim",
    "id": "w216"
  },
  {
    "text": "Боялся,",
    "start": 118.085,
    "end": 119.006,
    "line": "l29",
    "role": "maxim",
    "id": "w217"
  },
  { "text": "что", "start": 119.006, "end": 119.306, "line": "l29", "role": "maxim", "id": "w218" },
