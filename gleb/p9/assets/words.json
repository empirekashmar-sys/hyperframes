    "start": 110.768,
    "end": 111.348,
    "line": "l27",
    "role": "maxim",
    "id": "w204"
  },
  { "text": "Там", "start": 111.348, "end": 111.981, "line": "l27", "role": "maxim", "id": "w205" },
