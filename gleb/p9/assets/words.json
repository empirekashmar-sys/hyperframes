  { "text": "зайца", "start": 7.467, "end": 7.83, "line": "l02", "role": "narrator", "id": "w15" },
  { "text": "он", "start": 7.83, "end": 8.054, "line": "l02", "role": "narrator", "id": "w16" },
  { "text": "не", "start": 8.054, "end": 8.277, "line": "l02", "role": "narrator", "id": "w17" },
  { "text": "сказал", "start": 8.277, "end": 8.64, "line": "l02", "role": "narrator", "id": "w18" },
  { "text": "ни", "start": 8.64, "end": 8.863, "line": "l02", "role": "narrator", "id": "w19" },
  {
    "text": "слова.",
    "start": 8.863,
    "end": 9.226,
    "line": "l02",
    "role": "narrator",
    "id": "w20"
  },
  { "text": "Не", "start": 9.526, "end": 9.866, "line": "l03", "role": "maxim", "id": "w21" },
  { "text": "сейчас…", "start": 9.866, "end": 10.418, "line": "l03", "role": "maxim", "id": "w22" },
  {
    "text": "Сначала",
    "start": 10.418,
    "end": 11.546,
    "line": "l03",
    "role": "maxim",
    "id": "w23"
  },
  { "text": "сам", "start": 11.546, "end": 11.886, "line": "l03", "role": "maxim", "id": "w24" },
  {
    "text": "разберусь.",
    "start": 11.886,
    "end": 12.651,
    "line": "l03",
    "role": "maxim",
    "id": "w25"
  },
  {
    "text": "Замёрз?",
    "start": 13.651,
    "end": 14.087,
    "line": "l04",
    "role": "masha",
    "id": "w26"
  },
  { "text": "Иди", "start": 14.087, "end": 14.763, "line": "l04", "role": "masha", "id": "w27" },
  { "text": "сюда,", "start": 14.763, "end": 15.199, "line": "l04", "role": "masha", "id": "w28" },
  {
    "text": "грейся.",
    "start": 15.199,
    "end": 15.636,
    "line": "l04",
    "role": "masha",
    "id": "w29"
  },
  { "text": "Да", "start": 15.936, "end": 16.189, "line": "l05", "role": "maxim", "id": "w30" },
  { "text": "волки", "start": 16.189, "end": 16.6, "line": "l05", "role": "maxim", "id": "w31" },
  { "text": "там…", "start": 16.6, "end": 16.853, "line": "l05", "role": "maxim", "id": "w32" },
  { "text": "Я", "start": 16.853, "end": 17.392, "line": "l05", "role": "maxim", "id": "w33" },
  { "text": "их", "start": 17.392, "end": 17.645, "line": "l05", "role": "maxim", "id": "w34" },
  {
    "text": "топором",
    "start": 17.645,
    "end": 18.215,
    "line": "l05",
    "role": "maxim",
    "id": "w35"
  },
  {
    "text": "шуганул.",
    "start": 18.215,
    "end": 18.784,
    "line": "l05",
    "role": "maxim",
    "id": "w36"
  },
  { "text": "Трое", "start": 18.784, "end": 19.741, "line": "l05", "role": "maxim", "id": "w37" },
  { "text": "удрали,", "start": 19.741, "end": 20.31, "line": "l05", "role": "maxim", "id": "w38" },
  { "text": "а", "start": 20.31, "end": 20.798, "line": "l05", "role": "maxim", "id": "w39" },
  { "text": "один", "start": 20.798, "end": 21.209, "line": "l05", "role": "maxim", "id": "w40" },
  { "text": "до", "start": 21.209, "end": 21.462, "line": "l05", "role": "maxim", "id": "w41" },
  { "text": "сих", "start": 21.462, "end": 21.715, "line": "l05", "role": "maxim", "id": "w42" },
  { "text": "пор", "start": 21.715, "end": 21.968, "line": "l05", "role": "maxim", "id": "w43" },
  { "text": "бежит.", "start": 21.968, "end": 22.379, "line": "l05", "role": "maxim", "id": "w44" },
  { "text": "Герой", "start": 22.679, "end": 23.34, "line": "l06", "role": "masha", "id": "w45" },
  { "text": "ты", "start": 23.34, "end": 23.746, "line": "l06", "role": "masha", "id": "w46" },
  { "text": "мой.", "start": 23.746, "end": 24.153, "line": "l06", "role": "masha", "id": "w47" },
  { "text": "Она", "start": 24.453, "end": 24.812, "line": "l07", "role": "narrator", "id": "w48" },
  {
    "text": "встала",
    "start": 24.812,
    "end": 25.172,
    "line": "l07",
    "role": "narrator",
    "id": "w49"
  },
  { "text": "на", "start": 25.172, "end": 25.393, "line": "l07", "role": "narrator", "id": "w50" },
  {
    "text": "цыпочки",
    "start": 25.393,
    "end": 25.891,
    "line": "l07",
    "role": "narrator",
    "id": "w51"
  },
  { "text": "и", "start": 25.891, "end": 26.112, "line": "l07", "role": "narrator", "id": "w52" },
  {
    "text": "поцеловала",
    "start": 26.112,
    "end": 26.887,
    "line": "l07",
    "role": "narrator",
    "id": "w53"
  },
  {
    "text": "его.",
    "start": 26.887,
    "end": 27.246,
    "line": "l07",
    "role": "narrator",
    "id": "w54"
  },
  {
    "text": "Впервые",
    "start": 27.246,
    "end": 27.744,
    "line": "l07",
    "role": "narrator",
    "id": "w55"
  },
  {
    "text": "по-настоящему.",
    "start": 27.744,
    "end": 28.656,
    "line": "l07",
    "role": "narrator",
    "id": "w56"
  },
  { "text": "Маша…", "start": 29.156, "end": 29.565, "line": "l08", "role": "maxim", "id": "w57" },
  { "text": "У", "start": 29.565, "end": 29.817, "line": "l08", "role": "maxim", "id": "w58" },
  { "text": "меня", "start": 29.817, "end": 30.593, "line": "l08", "role": "maxim", "id": "w59" },
  { "text": "аж", "start": 30.593, "end": 30.845, "line": "l08", "role": "maxim", "id": "w60" },
  { "text": "борода", "start": 30.845, "end": 31.411, "line": "l08", "role": "maxim", "id": "w61" },
  {
    "text": "закурчавилась.",
    "start": 31.411,
    "end": 32.292,
    "line": "l08",
    "role": "maxim",
    "id": "w62"
  },
  { "text": "А", "start": 33.492, "end": 33.699, "line": "l09", "role": "narrator", "id": "w63" },
  {
    "text": "ночью",
    "start": 33.699,
    "end": 34.036,
    "line": "l09",
    "role": "narrator",
    "id": "w64"
  },
  {
    "text": "кровать",
    "start": 34.036,
    "end": 34.372,
    "line": "l09",
    "role": "narrator",
    "id": "w65"
  },
  { "text": "на", "start": 34.372, "end": 34.58, "line": "l09", "role": "narrator", "id": "w66" },
  {
    "text": "старой",
    "start": 34.58,
    "end": 34.916,
    "line": "l09",
    "role": "narrator",
    "id": "w67"
  },
  {
    "text": "даче",
    "start": 34.916,
    "end": 35.253,
    "line": "l09",
    "role": "narrator",
    "id": "w68"
  },
  {
    "text": "кипела",
    "start": 35.253,
    "end": 35.719,
    "line": "l09",
    "role": "narrator",
    "id": "w69"
  },
  { "text": "и", "start": 35.719, "end": 35.926, "line": "l09", "role": "narrator", "id": "w70" },
  {
    "text": "скрипела.",
    "start": 35.926,
    "end": 36.392,
    "line": "l09",
    "role": "narrator",
    "id": "w71"
  },
  { "text": "Всю", "start": 36.392, "end": 36.599, "line": "l09", "role": "narrator", "id": "w72" },
  {
    "text": "ночь.",
    "start": 36.599,
    "end": 36.806,
    "line": "l09",
    "role": "narrator",
    "id": "w73"
  },
  {
    "text": "Даже",
    "start": 37.806,
    "end": 38.127,
    "line": "l10",
    "role": "narrator",
    "id": "w74"
  },
  {
    "text": "волки",
    "start": 38.127,
    "end": 38.448,
    "line": "l10",
    "role": "narrator",
    "id": "w75"
  },
  { "text": "в", "start": 38.448, "end": 38.522, "line": "l10", "role": "narrator", "id": "w76" },
  {
    "text": "лесу",
    "start": 38.522,
    "end": 38.843,
    "line": "l10",
    "role": "narrator",
    "id": "w77"
  },
  { "text": "из", "start": 38.843, "end": 39.041, "line": "l10", "role": "narrator", "id": "w78" },
