    "text": "затемно.",
    "start": 3.914,
    "end": 4.428,
    "line": "l01",
    "role": "narrator",
    "id": "w5"
  },
  { "text": "С", "start": 4.428, "end": 4.514, "line": "l01", "role": "narrator", "id": "w6" },
