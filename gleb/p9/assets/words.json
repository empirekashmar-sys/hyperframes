[
  { "text": "Дед", "start": 2.2, "end": 2.429, "line": "l01", "role": "narrator", "id": "w0" },
  { "text": "Максим", "start": 2.429, "end": 2.8, "line": "l01", "role": "narrator", "id": "w1" },
