    "text": "уважения",
    "start": 39.041,
    "end": 39.733,
    "line": "l10",
    "role": "narrator",
    "id": "w79"
  },
  {
    "text": "ушли",
    "start": 39.733,
    "end": 40.054,
    "line": "l10",
    "role": "narrator",
    "id": "w80"
  },
  {
    "text": "подальше.",
    "start": 40.054,
    "end": 40.498,
    "line": "l10",
    "role": "narrator",
    "id": "w81"
  },
  { "text": "Ох…", "start": 41.698, "end": 42.059, "line": "l11", "role": "maxim", "id": "w82" },
  { "text": "Маша…", "start": 42.059, "end": 43.112, "line": "l11", "role": "maxim", "id": "w83" },
  { "text": "В", "start": 43.112, "end": 43.247, "line": "l11", "role": "maxim", "id": "w84" },
  {
    "text": "семьдесят",
    "start": 43.247,
    "end": 44.389,
    "line": "l11",
    "role": "maxim",
    "id": "w85"
  },
  {
    "text": "восьмом",
    "start": 44.389,
    "end": 44.975,
    "line": "l11",
    "role": "maxim",
    "id": "w86"
  },
  { "text": "я", "start": 44.975, "end": 45.336, "line": "l11", "role": "maxim", "id": "w87" },
  { "text": "так", "start": 45.336, "end": 45.697, "line": "l11", "role": "maxim", "id": "w88" },
  { "text": "не", "start": 45.697, "end": 46.057, "line": "l11", "role": "maxim", "id": "w89" },
  { "text": "мог.", "start": 46.057, "end": 46.418, "line": "l11", "role": "maxim", "id": "w90" },
  {
    "text": "Максим!",
    "start": 46.718,
    "end": 47.223,
    "line": "l12",
    "role": "masha",
    "id": "w91"
  },
  { "text": "Ты", "start": 47.223, "end": 47.937, "line": "l12", "role": "masha", "id": "w92" },
  { "text": "же", "start": 47.937, "end": 48.248, "line": "l12", "role": "masha", "id": "w93" },
  {
    "text": "говорил,",
    "start": 48.248,
    "end": 49.263,
    "line": "l12",
    "role": "masha",
    "id": "w94"
  },
  { "text": "что", "start": 49.263, "end": 49.574, "line": "l12", "role": "masha", "id": "w95" },
  { "text": "был", "start": 49.574, "end": 49.884, "line": "l12", "role": "masha", "id": "w96" },
  {
    "text": "красавец?",
    "start": 49.884,
    "end": 50.583,
    "line": "l12",
    "role": "masha",
    "id": "w97"
  },
  {
    "text": "Красавец",
    "start": 50.883,
    "end": 51.562,
    "line": "l13",
    "role": "maxim",
    "id": "w98"
  },
  { "text": "был.", "start": 51.562, "end": 51.864, "line": "l13", "role": "maxim", "id": "w99" },
  { "text": "А", "start": 51.864, "end": 52.166, "line": "l13", "role": "maxim", "id": "w100" },
  {
    "text": "теперь",
    "start": 52.166,
    "end": 53.069,
    "line": "l13",
    "role": "maxim",
    "id": "w101"
  },
  { "text": "ещё", "start": 53.069, "end": 53.56, "line": "l13", "role": "maxim", "id": "w102" },
  { "text": "и", "start": 53.56, "end": 53.862, "line": "l13", "role": "maxim", "id": "w103" },
  {
    "text": "опытный.",
    "start": 53.862,
    "end": 54.541,
    "line": "l13",
    "role": "maxim",
    "id": "w104"
  },
  {
    "text": "Опытный…",
    "start": 54.841,
    "end": 55.356,
    "line": "l14",
    "role": "masha",
    "id": "w105"
  },
  { "text": "Ну", "start": 55.356, "end": 56.027, "line": "l14", "role": "masha", "id": "w106" },
  { "text": "пошли", "start": 56.027, "end": 56.399, "line": "l14", "role": "masha", "id": "w107" },
  { "text": "в", "start": 56.399, "end": 56.485, "line": "l14", "role": "masha", "id": "w108" },
  { "text": "баню,", "start": 56.485, "end": 56.856, "line": "l14", "role": "masha", "id": "w109" },
  {
    "text": "опытный.",
    "start": 56.856,
    "end": 57.492,
    "line": "l14",
    "role": "masha",
    "id": "w110"
  },
  { "text": "Я", "start": 57.492, "end": 58.143, "line": "l14", "role": "masha", "id": "w111" },
  { "text": "с", "start": 58.143, "end": 58.229, "line": "l14", "role": "masha", "id": "w112" },
  {
    "text": "вечера",
    "start": 58.229,
    "end": 58.744,
    "line": "l14",
    "role": "masha",
    "id": "w113"
  },
  {
    "text": "натопила.",
    "start": 58.744,
    "end": 59.402,
    "line": "l14",
    "role": "masha",
    "id": "w114"
  },
  {
    "text": "Банька",
    "start": 60.402,
    "end": 60.784,
    "line": "l15",
    "role": "narrator",
    "id": "w115"
  },
  { "text": "на", "start": 60.784, "end": 61.019, "line": "l15", "role": "narrator", "id": "w116" },
  {
    "text": "краю",
    "start": 61.019,
    "end": 61.401,
    "line": "l15",
    "role": "narrator",
    "id": "w117"
  },
  {
    "text": "двора.",
    "start": 61.401,
    "end": 61.784,
    "line": "l15",
    "role": "narrator",
    "id": "w118"
  },
  {
    "text": "Пар,",
    "start": 61.784,
    "end": 62.019,
    "line": "l15",
    "role": "narrator",
    "id": "w119"
  },
  {
    "text": "веник",
    "start": 62.019,
    "end": 62.401,
    "line": "l15",
    "role": "narrator",
    "id": "w120"
  },
  { "text": "и", "start": 62.401, "end": 62.637, "line": "l15", "role": "narrator", "id": "w121" },
  {
    "text": "мороз",
    "start": 62.637,
    "end": 63.019,
    "line": "l15",
    "role": "narrator",
    "id": "w122"
  },
  { "text": "за", "start": 63.019, "end": 63.254, "line": "l15", "role": "narrator", "id": "w123" },
  {
    "text": "дверью.",
    "start": 63.254,
    "end": 63.637,
    "line": "l15",
    "role": "narrator",
    "id": "w124"
  },
  { "text": "Ух!", "start": 64.037, "end": 64.506, "line": "l16", "role": "maxim", "id": "w125" },
  {
    "text": "Поддай,",
    "start": 64.506,
    "end": 65.822,
    "line": "l16",
    "role": "maxim",
    "id": "w126"
  },
  {
    "text": "Машенька!",
    "start": 65.822,
    "end": 67.184,
    "line": "l16",
    "role": "maxim",
    "id": "w127"
  },
  {
    "text": "Поддай!",
    "start": 67.184,
    "end": 67.946,
    "line": "l16",
    "role": "maxim",
    "id": "w128"
  },
  { "text": "Не", "start": 68.246, "end": 68.715, "line": "l17", "role": "masha", "id": "w129" },
  {
    "text": "задохнись",
    "start": 68.715,
    "end": 69.499,
    "line": "l17",
    "role": "masha",
    "id": "w130"
  },
  { "text": "мне", "start": 69.499, "end": 69.793, "line": "l17", "role": "masha", "id": "w131" },
  { "text": "тут,", "start": 69.793, "end": 70.086, "line": "l17", "role": "masha", "id": "w132" },
  {
    "text": "старый!",
    "start": 70.086,
    "end": 70.562,
    "line": "l17",
    "role": "masha",
    "id": "w133"
  },
  { "text": "Я", "start": 70.862, "end": 71.326, "line": "l18", "role": "maxim", "id": "w134" },
  { "text": "в", "start": 71.326, "end": 71.499, "line": "l18", "role": "maxim", "id": "w135" },
  { "text": "танке", "start": 71.499, "end": 72.407, "line": "l18", "role": "maxim", "id": "w136" },
  { "text": "ехал", "start": 72.407, "end": 73.16, "line": "l18", "role": "maxim", "id": "w137" },
  { "text": "не", "start": 73.16, "end": 73.623, "line": "l18", "role": "maxim", "id": "w138" },
  {
    "text": "задохнулся!",
    "start": 73.623,
    "end": 74.955,
    "line": "l18",
    "role": "maxim",
    "id": "w139"
  },
  { "text": "А", "start": 75.355, "end": 75.602, "line": "l19", "role": "masha", "id": "w140" },
  { "text": "ну", "start": 75.602, "end": 75.848, "line": "l19", "role": "masha", "id": "w141" },
  {
    "text": "ложись.",
    "start": 75.848,
    "end": 76.249,
    "line": "l19",
    "role": "masha",
    "id": "w142"
  },
  {
    "text": "Сейчас",
