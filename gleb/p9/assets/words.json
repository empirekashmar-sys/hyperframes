    "text": "ночь",
    "start": 116.111,
    "end": 116.378,
    "line": "l28",
    "role": "masha",
    "id": "w213"
  },
  {
    "text": "молчал?!",
    "start": 116.378,
    "end": 116.811,
    "line": "l28",
    "role": "masha",
    "id": "w214"
  },
  { "text": "Я", "start": 117.111, "end": 117.411, "line": "l29", "role": "maxim", "id": "w215" },
