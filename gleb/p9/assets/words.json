    "text": "Максим!",
    "start": 103.918,
    "end": 104.411,
    "line": "l26",
    "role": "masha",
    "id": "w192"
  },
  {
    "text": "Откуда",
    "start": 104.411,
    "end": 105.326,
    "line": "l26",
    "role": "masha",
    "id": "w193"
  },
  {
    "text": "это?!",
    "start": 105.326,
    "end": 105.818,
    "line": "l26",
    "role": "masha",
    "id": "w194"
  },
  { "text": "Ты", "start": 105.818, "end": 106.322, "line": "l26", "role": "masha", "id": "w195" },
