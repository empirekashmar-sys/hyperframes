    "text": "следы",
    "start": 111.981,
    "end": 112.561,
    "line": "l27",
    "role": "maxim",
    "id": "w206"
  },
  {
    "text": "были…",
    "start": 112.561,
    "end": 113.369,
    "line": "l27",
    "role": "maxim",
    "id": "w207"
  },
  {
    "text": "детские.",
    "start": 113.369,
    "end": 114.172,
    "line": "l27",
    "role": "maxim",
    "id": "w208"
  },
  { "text": "И", "start": 114.472, "end": 114.738, "line": "l28", "role": "masha", "id": "w209" },
  { "text": "ты", "start": 114.738, "end": 115.005, "line": "l28", "role": "masha", "id": "w210" },
  {
    "text": "молчал?!",
    "start": 115.005,
    "end": 115.844,
    "line": "l28",
    "role": "masha",
    "id": "w211"
  },
  { "text": "Всю", "start": 115.844, "end": 116.111, "line": "l28", "role": "masha", "id": "w212" },
