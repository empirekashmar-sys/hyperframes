    "start": 77.892,
    "end": 78.447,
    "line": "l19",
    "role": "masha",
    "id": "w146"
  },
  { "text": "Ой…", "start": 79.247, "end": 79.959, "line": "l20", "role": "maxim", "id": "w147" },
