    "text": "приказ.",
    "start": 89.974,
    "end": 90.408,
    "line": "l19",
    "role": "gleb",
    "id": "w185"
  },
  {
    "text": "Утром",
    "start": 91.608,
    "end": 92.054,
    "line": "l20",
    "role": "narrator",
    "id": "w186"
  },
