    "text": "Глеб",
    "start": 92.054,
    "end": 92.328,
    "line": "l20",
    "role": "narrator",
    "id": "w187"
  },
  {
    "text": "пришёл",
    "start": 92.328,
    "end": 92.774,
    "line": "l20",
    "role": "narrator",
    "id": "w188"
  },
  { "text": "в", "start": 92.774, "end": 92.877, "line": "l20", "role": "narrator", "id": "w189" },
  {
    "text": "бокс",
    "start": 92.877,
    "end": 93.152,
    "line": "l20",
    "role": "narrator",
    "id": "w190"
  },
  { "text": "к", "start": 93.152, "end": 93.255, "line": "l20", "role": "narrator", "id": "w191" },
  {
    "text": "Маше.",
    "start": 93.255,
    "end": 93.701,
    "line": "l20",
    "role": "narrator",
    "id": "w192"
  },
  {
