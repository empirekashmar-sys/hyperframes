    "end": 87.018,
    "line": "l19",
    "role": "gleb",
    "id": "w178"
  },
  { "text": "Лиса.", "start": 87.018, "end": 87.452, "line": "l19", "role": "gleb", "id": "w179" },
  {
    "text": "Забудь,",
    "start": 87.452,
    "end": 88.213,
    "line": "l19",
    "role": "gleb",
    "id": "w180"
  },
  { "text": "что", "start": 88.213, "end": 88.48, "line": "l19", "role": "gleb", "id": "w181" },
  { "text": "ты", "start": 88.48, "end": 88.747, "line": "l19", "role": "gleb", "id": "w182" },
  {
    "text": "слышала.",
    "start": 88.747,
    "end": 89.347,
    "line": "l19",
    "role": "gleb",
    "id": "w183"
  },
  { "text": "Это", "start": 89.347, "end": 89.974, "line": "l19", "role": "gleb", "id": "w184" },
