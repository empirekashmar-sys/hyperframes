    "start": 80.521,
    "end": 81.017,
    "line": "l17",
    "role": "gleb",
    "id": "w164"
  },
  {
    "text": "генералу.",
    "start": 81.017,
    "end": 81.882,
    "line": "l17",
    "role": "gleb",
    "id": "w165"
  },
  { "text": "И", "start": 81.882, "end": 82.103, "line": "l17", "role": "gleb", "id": "w166" },
  { "text": "я", "start": 82.103, "end": 82.323, "line": "l17", "role": "gleb", "id": "w167" },
  { "text": "ей", "start": 82.323, "end": 82.544, "line": "l17", "role": "gleb", "id": "w168" },
  { "text": "верен.", "start": 82.544, "end": 82.902, "line": "l17", "role": "gleb", "id": "w169" },
  { "text": "Тогда", "start": 83.502, "end": 83.814, "line": "l18", "role": "fox", "id": "w170" },
