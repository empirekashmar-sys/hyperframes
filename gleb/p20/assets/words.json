    "end": 95.027,
    "line": "l21",
    "role": "masha",
    "id": "w194"
  },
  { "text": "на", "start": 95.027, "end": 95.24, "line": "l21", "role": "masha", "id": "w195" },
  { "text": "свою", "start": 95.24, "end": 95.587, "line": "l21", "role": "masha", "id": "w196" },
