    "text": "командир.",
    "start": 84.198,
    "end": 84.846,
    "line": "l18",
    "role": "fox",
    "id": "w173"
  },
  { "text": "Ты", "start": 84.846, "end": 85.038, "line": "l18", "role": "fox", "id": "w174" },
