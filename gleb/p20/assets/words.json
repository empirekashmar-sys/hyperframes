  { "text": "нужны", "start": 99.1, "end": 99.502, "line": "l22", "role": "gleb", "id": "w204" },
  { "text": "силы.", "start": 99.502, "end": 99.905, "line": "l22", "role": "gleb", "id": "w205" },
  { "text": "Ты", "start": 100.255, "end": 100.651, "line": "l23", "role": "masha", "id": "w206" },
