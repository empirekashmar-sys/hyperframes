    "text": "добычу?",
    "start": 95.587,
    "end": 96.067,
    "line": "l21",
    "role": "masha",
    "id": "w197"
  },
  { "text": "Пришёл", "start": 96.417, "end": 96.82, "line": "l22", "role": "gleb", "id": "w198" },
