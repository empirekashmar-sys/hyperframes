  { "text": "Ты", "start": 115.117, "end": 115.857, "line": "l25", "role": "masha", "id": "w239" },
  {
    "text": "служишь",
    "start": 115.857,
    "end": 116.216,
    "line": "l25",
    "role": "masha",
    "id": "w240"
  },
  {
    "text": "тем,",
    "start": 116.216,
