    "text": "извини",
    "start": 110.009,
    "end": 110.573,
    "line": "l24",
    "role": "gleb",
    "id": "w226"
  },
  { "text": "меня", "start": 110.573, "end": 110.98, "line": "l24", "role": "gleb", "id": "w227" },
  { "text": "за", "start": 110.98, "end": 111.231, "line": "l24", "role": "gleb", "id": "w228" },
  { "text": "это,", "start": 111.231, "end": 111.638, "line": "l24", "role": "gleb", "id": "w229" },
