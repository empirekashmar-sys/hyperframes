    "text": "извини",
    "start": 109.587,
    "end": 110.134,
    "line": "l24",
    "role": "gleb",
    "id": "w226"
  },
  { "text": "меня", "start": 110.134, "end": 110.528, "line": "l24", "role": "gleb", "id": "w227" },
  { "text": "за", "start": 110.528, "end": 110.983, "line": "l24", "role": "gleb", "id": "w228" },
