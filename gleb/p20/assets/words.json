  { "text": "было", "start": 73.716, "end": 74.116, "line": "l15", "role": "gleb", "id": "w147" },
  { "text": "сжечь,", "start": 74.116, "end": 74.362, "line": "l15", "role": "gleb", "id": "w148" },
  { "text": "чтобы", "start": 74.362, "end": 74.762, "line": "l15", "role": "gleb", "id": "w149" },
  {
    "text": "построить",
    "start": 74.762,
    "end": 75.316,
    "line": "l15",
    "role": "gleb",
    "id": "w150"
  },
  { "text": "новый.", "start": 75.316, "end": 75.716, "line": "l15", "role": "gleb", "id": "w151" },
  { "text": "Там", "start": 76.066, "end": 76.251, "line": "l16", "role": "fox", "id": "w152" },
  { "text": "были", "start": 76.251, "end": 76.552, "line": "l16", "role": "fox", "id": "w153" },
  { "text": "твои", "start": 76.552, "end": 76.853, "line": "l16", "role": "fox", "id": "w154" },
  { "text": "дети,", "start": 76.853, "end": 77.154, "line": "l16", "role": "fox", "id": "w155" },
  { "text": "Глеб!", "start": 77.154, "end": 77.34, "line": "l16", "role": "fox", "id": "w156" },
  { "text": "Я", "start": 77.84, "end": 78.06, "line": "l17", "role": "gleb", "id": "w157" },
  { "text": "знаю.", "start": 78.06, "end": 78.419, "line": "l17", "role": "gleb", "id": "w158" },
  { "text": "Это", "start": 78.419, "end": 79.108, "line": "l17", "role": "gleb", "id": "w159" },
  { "text": "была", "start": 79.108, "end": 79.466, "line": "l17", "role": "gleb", "id": "w160" },
  { "text": "цена.", "start": 79.466, "end": 79.824, "line": "l17", "role": "gleb", "id": "w161" },
  { "text": "Я", "start": 79.824, "end": 80.3, "line": "l17", "role": "gleb", "id": "w162" },
  { "text": "дал", "start": 80.3, "end": 80.521, "line": "l17", "role": "gleb", "id": "w163" },
