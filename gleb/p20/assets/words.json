    "text": "проверить,",
    "start": 96.82,
    "end": 97.377,
    "line": "l22",
    "role": "gleb",
    "id": "w199"
  },
  { "text": "как", "start": 97.377, "end": 97.625, "line": "l22", "role": "gleb", "id": "w200" },
  { "text": "ты", "start": 97.625, "end": 97.873, "line": "l22", "role": "gleb", "id": "w201" },
  { "text": "ешь.", "start": 97.873, "end": 98.121, "line": "l22", "role": "gleb", "id": "w202" },
  { "text": "Ребёнку", "start": 98.121, "end": 99.1, "line": "l22", "role": "gleb", "id": "w203" },
  { "text": "нужны", "start": 99.1, "end": 99.502, "line": "l22", "role": "gleb", "id": "w204" },
  { "text": "силы.", "start": 99.502, "end": 99.905, "line": "l22", "role": "gleb", "id": "w205" },
  { "text": "Ты", "start": 100.255, "end": 100.651, "line": "l23", "role": "masha", "id": "w206" },
