    "text": "мужиком.",
    "start": 116.358,
    "end": 117.045,
    "line": "l24",
    "role": "maxim",
    "id": "w198"
  },
  { "text": "Дед,", "start": 117.445, "end": 117.676, "line": "l25", "role": "gleb", "id": "w199" },
  { "text": "ты", "start": 117.676, "end": 118.103, "line": "l25", "role": "gleb", "id": "w200" },
