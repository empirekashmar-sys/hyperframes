    "text": "смысле",
    "start": 128.775,
    "end": 129.374,
    "line": "l27",
    "role": "gleb",
    "id": "w221"
  },
  {
    "text": "вместе?",
    "start": 129.374,
    "end": 129.973,
    "line": "l27",
    "role": "gleb",
    "id": "w222"
  },
  {
    "text": "Глеб…",
    "start": 130.373,
    "end": 130.896,
    "line": "l28",
    "role": "masha",
    "id": "w223"
  },
