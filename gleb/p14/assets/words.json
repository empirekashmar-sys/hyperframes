    "text": "она.",
    "start": 142.097,
    "end": 142.903,
    "line": "l30",
    "role": "maxim",
    "id": "w245"
  },
  { "text": "Бей", "start": 142.903, "end": 143.226, "line": "l30", "role": "maxim", "id": "w246" },
