    "end": 104.942,
    "line": "l21",
    "role": "masha",
    "id": "w174"
  },
  {
    "text": "Слышишь?",
    "start": 104.942,
    "end": 105.668,
    "line": "l21",
    "role": "masha",
    "id": "w175"
  },
  {
    "text": "Найдём.",
    "start": 105.668,
    "end": 106.181,
    "line": "l21",
    "role": "masha",
    "id": "w176"
  },
  { "text": "А", "start": 106.981, "end": 107.218, "line": "l22", "role": "gleb", "id": "w177" },
  { "text": "это", "start": 107.218, "end": 107.604, "line": "l22", "role": "gleb", "id": "w178" },
  { "text": "что", "start": 107.604, "end": 107.841, "line": "l22", "role": "gleb", "id": "w179" },
  { "text": "у", "start": 107.841, "end": 108.079, "line": "l22", "role": "gleb", "id": "w180" },
  { "text": "тебя", "start": 108.079, "end": 108.465, "line": "l22", "role": "gleb", "id": "w181" },
  { "text": "на", "start": 108.465, "end": 108.702, "line": "l22", "role": "gleb", "id": "w182" },
