    "start": 158.296,
    "end": 158.652,
    "line": "l35",
    "role": "narrator",
    "id": "w268"
  },
  {
    "text": "на",
    "start": 158.652,
    "end": 158.871,
    "line": "l35",
    "role": "narrator",
    "id": "w269"
  },
  {
    "text": "неё.",
    "start": 158.871,
    "end": 159.226,
    "line": "l35",
    "role": "narrator",
    "id": "w270"
  },
  {
    "text": "Потом",
    "start": 159.226,
    "end": 159.759,
    "line": "l35",
    "role": "narrator",
    "id": "w271"
  },
  {
    "text": "на",
    "start": 159.759,
    "end": 159.977,
    "line": "l35",
    "role": "narrator",
    "id": "w272"
  },
  {
    "text": "деда.",
    "start": 159.977,
    "end": 160.333,
    "line": "l35",
    "role": "narrator",
    "id": "w273"
  },
