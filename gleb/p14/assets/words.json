  { "text": "стою", "start": 99.263, "end": 99.67, "line": "l20", "role": "gleb", "id": "w165" },
  { "text": "у", "start": 99.67, "end": 99.92, "line": "l20", "role": "gleb", "id": "w166" },
  { "text": "ворот.", "start": 99.92, "end": 100.644, "line": "l20", "role": "gleb", "id": "w167" },
