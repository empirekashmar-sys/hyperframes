    "start": 87.622,
    "end": 87.997,
    "line": "l17",
    "role": "narrator",
    "id": "w145"
  },
  { "text": "Глеб…", "start": 88.797, "end": 89.146, "line": "l18", "role": "masha", "id": "w146" },
  { "text": "Где", "start": 89.146, "end": 89.875, "line": "l18", "role": "masha", "id": "w147" },
  {
