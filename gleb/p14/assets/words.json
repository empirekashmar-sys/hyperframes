    "text": "даче.",
    "start": 125.302,
    "end": 125.795,
    "line": "l26",
    "role": "maxim",
    "id": "w215"
  },
  {
    "text": "Потом",
    "start": 125.795,
    "end": 126.611,
    "line": "l26",
    "role": "maxim",
    "id": "w216"
  },
