    "start": 101.771,
    "end": 102.683,
    "line": "l20",
    "role": "gleb",
    "id": "w170"
  },
  {
    "text": "Вдруг…",
    "start": 102.683,
    "end": 102.933,
    "line": "l20",
    "role": "gleb",
    "id": "w171"
  },
