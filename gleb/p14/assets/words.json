    "text": "очнулся",
    "start": 96.089,
    "end": 96.744,
    "line": "l19",
    "role": "gleb",
    "id": "w158"
  },
  { "text": "а", "start": 96.744, "end": 97.239, "line": "l19", "role": "gleb", "id": "w159" },
  { "text": "их", "start": 97.239, "end": 97.53, "line": "l19", "role": "gleb", "id": "w160" },
  { "text": "нет.", "start": 97.53, "end": 97.821, "line": "l19", "role": "gleb", "id": "w161" },
  { "text": "Я", "start": 98.355, "end": 98.605, "line": "l20", "role": "gleb", "id": "w162" },
  { "text": "каждый", "start": 98.605, "end": 99.012, "line": "l20", "role": "gleb", "id": "w163" },
