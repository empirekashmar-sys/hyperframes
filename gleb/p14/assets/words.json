    "end": 90.66,
    "line": "l18",
    "role": "masha",
    "id": "w148"
  },
  { "text": "Я", "start": 91.16, "end": 91.451, "line": "l19", "role": "gleb", "id": "w149" },
  { "text": "их", "start": 91.451, "end": 91.742, "line": "l19", "role": "gleb", "id": "w150" },
