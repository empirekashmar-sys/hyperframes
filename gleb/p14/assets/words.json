    "start": 118.479,
    "end": 118.855,
    "line": "l25",
    "role": "gleb",
    "id": "w202"
  },
  {
    "text": "серьёзный?",
    "start": 118.855,
    "end": 119.375,
    "line": "l25",
    "role": "gleb",
    "id": "w203"
  },
  {
