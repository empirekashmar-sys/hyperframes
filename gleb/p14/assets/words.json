    "start": 93.75,
    "end": 94.766,
    "line": "l19",
    "role": "gleb",
    "id": "w154"
  },
  { "text": "Взрыв…", "start": 94.766, "end": 95.057, "line": "l19", "role": "gleb", "id": "w155" },
