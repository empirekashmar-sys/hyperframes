    "start": 113.841,
    "end": 114.337,
    "line": "l24",
    "role": "maxim",
    "id": "w193"
  },
  {
    "text": "поговорить.",
    "start": 114.337,
    "end": 115.214,
    "line": "l24",
    "role": "maxim",
    "id": "w194"
  },
  { "text": "Как", "start": 115.214, "end": 115.748, "line": "l24", "role": "maxim", "id": "w195" },
