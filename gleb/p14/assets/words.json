    "text": "было…",
    "start": 120.875,
    "end": 121.808,
    "line": "l26",
    "role": "maxim",
    "id": "w207"
  },
  { "text": "Мы", "start": 121.808, "end": 122.111, "line": "l26", "role": "maxim", "id": "w208" },
