    "text": "пальце?",
    "start": 108.702,
    "end": 109.283,
    "line": "l22",
    "role": "gleb",
    "id": "w183"
  },
  {
    "text": "Гайка?",
    "start": 109.283,
    "end": 109.669,
    "line": "l22",
    "role": "gleb",
    "id": "w184"
  },
  {
    "text": "Маша",
    "start": 110.169,
    "end": 110.554,
    "line": "l23",
    "role": "narrator",
    "id": "w185"
  },
  {
    "text": "спрятала",
    "start": 110.554,
    "end": 111.088,
    "line": "l23",
    "role": "narrator",
    "id": "w186"
  },
  {
    "text": "руку.",
    "start": 111.088,
    "end": 111.474,
    "line": "l23",
    "role": "narrator",
    "id": "w187"
  },
  {
    "text": "Дед",
    "start": 111.474,
    "end": 111.711,
    "line": "l23",
    "role": "narrator",
    "id": "w188"
  },
  {
    "text": "Максим",
    "start": 111.711,
    "end": 112.097,
    "line": "l23",
    "role": "narrator",
    "id": "w189"
  },
  {
    "text": "кашлянул.",
    "start": 112.097,
    "end": 112.631,
    "line": "l23",
    "role": "narrator",
    "id": "w190"
  },
  {
    "text": "Глеб…",
    "start": 113.231,
    "end": 113.536,
    "line": "l24",
    "role": "maxim",
    "id": "w191"
  },
  { "text": "Нам", "start": 113.536, "end": 113.841, "line": "l24", "role": "maxim", "id": "w192" },
