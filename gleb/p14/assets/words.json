    "text": "Каждую",
    "start": 100.644,
    "end": 101.208,
    "line": "l20",
    "role": "gleb",
    "id": "w168"
  },
  {
    "text": "машину",
    "start": 101.208,
    "end": 101.771,
    "line": "l20",
    "role": "gleb",
    "id": "w169"
  },
