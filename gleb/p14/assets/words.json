    "text": "мужик",
    "start": 115.748,
    "end": 116.244,
    "line": "l24",
    "role": "maxim",
    "id": "w196"
  },
  { "text": "с", "start": 116.244, "end": 116.358, "line": "l24", "role": "maxim", "id": "w197" },
