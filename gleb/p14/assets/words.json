    "start": 147.333,
    "end": 148.462,
    "line": "l31",
    "role": "masha",
    "id": "w253"
  },
  {
    "text": "Глеб…",
    "start": 148.462,
    "end": 148.722,
    "line": "l31",
    "role": "masha",
    "id": "w254"
  },
