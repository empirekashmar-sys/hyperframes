    "text": "моря.",
    "start": 126.914,
    "end": 127.407,
    "line": "l26",
    "role": "maxim",
    "id": "w218"
  },
  {
    "text": "Вместе?",
    "start": 127.807,
    "end": 128.406,
    "line": "l27",
    "role": "gleb",
    "id": "w219"
  },
  { "text": "В", "start": 128.406, "end": 128.775, "line": "l27", "role": "gleb", "id": "w220" },
