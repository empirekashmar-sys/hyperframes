    "text": "Туда,",
    "start": 175.653,
    "end": 176.08,
    "line": "l40",
    "role": "maxim",
    "id": "w309"
  },
  { "text": "где", "start": 176.08, "end": 176.342, "line": "l40", "role": "maxim", "id": "w310" },
  { "text": "он.", "start": 176.342, "end": 176.605, "line": "l40", "role": "maxim", "id": "w311" },
  { "text": "Я", "start": 176.605, "end": 177.357, "line": "l40", "role": "maxim", "id": "w312" },
  { "text": "его", "start": 177.357, "end": 177.784, "line": "l40", "role": "maxim", "id": "w313" },
