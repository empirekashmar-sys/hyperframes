    "text": "найду,",
    "start": 177.784,
    "end": 178.211,
    "line": "l40",
    "role": "maxim",
    "id": "w314"
  },
  {
    "text": "Маша.",
    "start": 178.211,
    "end": 178.637,
    "line": "l40",
    "role": "maxim",
    "id": "w315"
  },
  {
    "text": "Гуля",
    "start": 178.637,
    "end": 179.493,
    "line": "l40",
    "role": "maxim",
    "id": "w316"
  },
  {
    "text": "этого.",
    "start": 179.493,
    "end": 180.084,
    "line": "l40",
    "role": "maxim",
    "id": "w317"
  },
  { "text": "Я", "start": 180.084, "end": 180.705, "line": "l40", "role": "maxim", "id": "w318" },
  { "text": "ему", "start": 180.705, "end": 181.132, "line": "l40", "role": "maxim", "id": "w319" },
  { "text": "в", "start": 181.132, "end": 181.23, "line": "l40", "role": "maxim", "id": "w320" },
  {
    "text": "глаза",
    "start": 181.23,
    "end": 181.657,
    "line": "l40",
    "role": "maxim",
    "id": "w321"
  },
  {
    "text": "посмотрю.",
    "start": 181.657,
    "end": 182.248,
    "line": "l40",
    "role": "maxim",
    "id": "w322"
  },
  {
    "text": "Возьми…",
    "start": 182.848,
    "end": 183.248,
    "line": "l41",
    "role": "masha",
    "id": "w323"
  },
  { "text": "В", "start": 183.248, "end": 183.34, "line": "l41", "role": "masha", "id": "w324" },
  {
    "text": "кармане…",
    "start": 183.34,
    "end": 184.414,
    "line": "l41",
    "role": "masha",
    "id": "w325"
  },
  { "text": "Я", "start": 184.414, "end": 184.661, "line": "l41", "role": "masha", "id": "w326" },
  {
    "text": "подобрала",
    "start": 184.661,
    "end": 185.819,
    "line": "l41",
    "role": "masha",
    "id": "w327"
  },
  { "text": "его", "start": 185.819, "end": 186.219, "line": "l41", "role": "masha", "id": "w328" },
  {
    "text": "куртку.",
    "start": 186.219,
    "end": 186.619,
    "line": "l41",
    "role": "masha",
    "id": "w329"
  },
  {
    "text": "Дед",
    "start": 187.019,
    "end": 187.233,
    "line": "l42",
    "role": "narrator",
    "id": "w330"
  },
  {
    "text": "достал",
    "start": 187.233,
    "end": 187.579,
    "line": "l42",
    "role": "narrator",
    "id": "w331"
  },
  {
    "text": "из",
    "start": 187.579,
    "end": 187.792,
    "line": "l42",
    "role": "narrator",
    "id": "w332"
  },
  {
    "text": "кармана",
    "start": 187.792,
    "end": 188.272,
    "line": "l42",
    "role": "narrator",
    "id": "w333"
  },
  {
    "text": "кожаной",
    "start": 188.272,
    "end": 188.751,
    "line": "l42",
    "role": "narrator",
    "id": "w334"
  },
  {
    "text": "куртки",
    "start": 188.751,
    "end": 189.098,
    "line": "l42",
    "role": "narrator",
    "id": "w335"
  },
  {
    "text": "Глеба",
    "start": 189.098,
    "end": 189.444,
    "line": "l42",
    "role": "narrator",
    "id": "w336"
  },
  {
    "text": "пластиковую",
    "start": 189.444,
    "end": 190.19,
    "line": "l42",
    "role": "narrator",
    "id": "w337"
  },
  {
    "text": "карточку.",
    "start": 190.19,
    "end": 190.67,
    "line": "l42",
    "role": "narrator",
    "id": "w338"
  },
  {
    "text": "«Лаборатория",
    "start": 191.07,
    "end": 192.081,
    "line": "l43",
    "role": "narrator",
    "id": "w339"
  },
  {
    "text": "\"Улей\".",
    "start": 192.081,
    "end": 192.48,
    "line": "l43",
    "role": "narrator",
    "id": "w340"
  },
  {
    "text": "Уровень",
    "start": 192.48,
    "end": 193.031,
    "line": "l43",
    "role": "narrator",
    "id": "w341"
  },
  {
    "text": "доступа",
    "start": 193.031,
    "end": 193.583,
    "line": "l43",
    "role": "narrator",
    "id": "w342"
  },
  {
    "text": "три.",
    "start": 193.583,
    "end": 193.828,
    "line": "l43",
    "role": "narrator",
    "id": "w343"
  },
  {
    "text": "Соколов",
    "start": 193.828,
    "end": 194.38,
    "line": "l43",
    "role": "narrator",
    "id": "w344"
  },
  {
    "text": "Г.»",
    "start": 194.38,
    "end": 194.472,
    "line": "l43",
    "role": "narrator",
    "id": "w345"
  },
  {
    "text": "Улей…",
    "start": 195.272,
    "end": 196.176,
    "line": "l44",
    "role": "maxim",
    "id": "w346"
  },
  { "text": "Ну…", "start": 196.176, "end": 196.929, "line": "l44", "role": "maxim", "id": "w347" },
  {
    "text": "держись,",
    "start": 196.929,
    "end": 198.04,
    "line": "l44",
    "role": "maxim",
    "id": "w348"
  },
  { "text": "Гуль.", "start": 198.04, "end": 198.597, "line": "l44", "role": "maxim", "id": "w349" }
