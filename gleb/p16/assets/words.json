    "text": "контакта",
    "start": 170.267,
    "end": 170.783,
    "line": "l38",
    "role": "voice",
    "id": "w301"
  },
  { "text": "с", "start": 170.783, "end": 170.869, "line": "l38", "role": "voice", "id": "w302" },
