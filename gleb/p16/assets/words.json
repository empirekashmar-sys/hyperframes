    "text": "заражёнными.",
    "start": 170.869,
    "end": 171.973,
    "line": "l38",
    "role": "voice",
    "id": "w303"
  },
  {
    "text": "Повторяем…",
    "start": 171.973,
    "end": 172.633,
    "line": "l38",
    "role": "voice",
    "id": "w304"
  },
  {
    "text": "Максим…",
    "start": 173.233,
    "end": 173.662,
    "line": "l39",
    "role": "masha",
    "id": "w305"
  },
  { "text": "Куда", "start": 173.662, "end": 174.66, "line": "l39", "role": "masha", "id": "w306" },
  { "text": "мы", "start": 174.66, "end": 174.924, "line": "l39", "role": "masha", "id": "w307" },
