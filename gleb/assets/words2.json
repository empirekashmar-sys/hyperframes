    "start": 18.404,
    "end": 18.826,
    "line": "l06",
    "role": "son_young",
    "id": "w39"
  },
  { "text": "Ого!", "start": 19.026, "end": 19.505, "line": "l07", "role": "gleb", "id": "w40" },
