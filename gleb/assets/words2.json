    "role": "gleb",
    "id": "w41"
  },
  { "text": "после", "start": 20.496, "end": 20.975, "line": "l07", "role": "gleb", "id": "w42" },
  { "text": "ужина?", "start": 20.975, "end": 21.638, "line": "l07", "role": "gleb", "id": "w43" },
  {
    "text": "Мальчики,",
    "start": 22.138,
    "end": 22.796,
    "line": "l08",
    "role": "masha",
    "id": "w44"
  },
  { "text": "мойте", "start": 22.796, "end": 23.271, "line": "l08", "role": "masha", "id": "w45" },
  { "text": "руки!", "start": 23.271, "end": 23.746, "line": "l08", "role": "masha", "id": "w46" },
  { "text": "Ужин", "start": 23.746, "end": 24.465, "line": "l08", "role": "masha", "id": "w47" },
  { "text": "стынет!", "start": 24.465, "end": 24.94, "line": "l08", "role": "masha", "id": "w48" },
  { "text": "Хлеб", "start": 25.54, "end": 25.82, "line": "l09", "role": "masha", "id": "w49" },
  { "text": "купил?", "start": 25.82, "end": 26.275, "line": "l09", "role": "masha", "id": "w50" },
  { "text": "Ой…", "start": 26.525, "end": 27.265, "line": "l10", "role": "gleb", "id": "w51" },
  { "text": "Ну", "start": 27.565, "end": 27.908, "line": "l11", "role": "masha", "id": "w52" },
  {
    "text": "конечно.",
    "start": 27.908,
    "end": 28.681,
    "line": "l11",
    "role": "masha",
    "id": "w53"
  },
  { "text": "Они", "start": 29.381, "end": 29.739, "line": "l12", "role": "narrator", "id": "w54" },
