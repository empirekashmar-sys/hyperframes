  { "text": "собака.", "start": 13.916, "end": 14.591, "line": "l05", "role": "gleb", "id": "w29" },
  { "text": "А", "start": 14.591, "end": 14.891, "line": "l05", "role": "gleb", "id": "w30" },
  { "text": "у", "start": 14.891, "end": 15.525, "line": "l05", "role": "gleb", "id": "w31" },
  { "text": "вас", "start": 15.525, "end": 15.825, "line": "l05", "role": "gleb", "id": "w32" },
  { "text": "что?", "start": 15.825, "end": 16.125, "line": "l05", "role": "gleb", "id": "w33" },
  { "text": "А", "start": 16.425, "end": 16.613, "line": "l06", "role": "son_young", "id": "w34" },
  { "text": "я", "start": 16.613, "end": 16.801, "line": "l06", "role": "son_young", "id": "w35" },
