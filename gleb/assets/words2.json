  { "text": "Нет,", "start": 43.716, "end": 44.047, "line": "l17", "role": "gleb", "id": "w79" },
  { "text": "Маш.", "start": 44.047, "end": 44.379, "line": "l17", "role": "gleb", "id": "w80" },
  { "text": "Это", "start": 44.379, "end": 44.917, "line": "l17", "role": "gleb", "id": "w81" },
  { "text": "не", "start": 44.917, "end": 45.248, "line": "l17", "role": "gleb", "id": "w82" },
  { "text": "гроза.", "start": 45.248, "end": 45.786, "line": "l17", "role": "gleb", "id": "w83" },
  { "text": "Буди", "start": 47.186, "end": 47.69, "line": "l18", "role": "gleb", "id": "w84" },
