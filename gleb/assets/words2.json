    "start": 51.705,
    "end": 52.139,
    "line": "l19",
    "role": "son_young",
    "id": "w91"
  },
  { "text": "Нет,", "start": 52.339, "end": 52.635, "line": "l20", "role": "masha", "id": "w92" },
  { "text": "зайка.", "start": 52.635, "end": 53.115, "line": "l20", "role": "masha", "id": "w93" },
  {
    "text": "Одевайся.",
    "start": 53.115,
    "end": 54.251,
    "line": "l20",
    "role": "masha",
    "id": "w94"
  },
  { "text": "Мам,", "start": 54.501, "end": 54.779, "line": "l21", "role": "son_old", "id": "w95" },
