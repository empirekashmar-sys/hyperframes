  {
    "text": "случилось?",
    "start": 55.221,
    "end": 55.846,
    "line": "l21",
    "role": "son_old",
    "id": "w97"
  },
  { "text": "Потом.", "start": 56.046, "end": 56.547, "line": "l22", "role": "masha", "id": "w98" },
