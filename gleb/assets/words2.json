    "text": "привет.",
    "start": 9.502,
    "end": 9.916,
    "line": "l04",
    "role": "son_old",
    "id": "w23"
  },
  { "text": "Как", "start": 9.916, "end": 10.736, "line": "l04", "role": "son_old", "id": "w24" },
