  { "text": "это", "start": 8.944, "end": 9.293, "line": "l03", "role": "son_young", "id": "w15" },
  { "text": "кто?", "start": 9.293, "end": 9.507, "line": "l03", "role": "son_young", "id": "w16" },
  {
    "text": "Дверь",
    "start": 9.807,
    "end": 10.106,
    "line": "l04",
    "role": "narrator",
    "id": "w17"
  },
  {
    "text": "открылась.",
    "start": 10.106,
    "end": 10.78,
    "line": "l04",
    "role": "narrator",
    "id": "w18"
  },
