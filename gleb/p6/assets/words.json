    "text": "началась",
    "start": 62.489,
    "end": 62.937,
    "line": "l20",
    "role": "narrator",
    "id": "w112"
  },
  {
    "text": "перестрелка.",
    "start": 62.937,
    "end": 63.509,
    "line": "l20",
    "role": "narrator",
    "id": "w113"
  },
  { "text": "Это", "start": 65.509, "end": 65.927, "line": "l21", "role": "zina", "id": "w114" },
  { "text": "что", "start": 65.927, "end": 66.185, "line": "l21", "role": "zina", "id": "w115" },
  { "text": "за", "start": 66.185, "end": 66.442, "line": "l21", "role": "zina", "id": "w116" },
  {
    "text": "безобразие?!",
    "start": 66.442,
    "end": 67.697,
    "line": "l21",
    "role": "zina",
    "id": "w117"
  },
  { "text": "Ночь", "start": 67.697, "end": 67.954, "line": "l21", "role": "zina", "id": "w118" },
  { "text": "на", "start": 67.954, "end": 68.211, "line": "l21", "role": "zina", "id": "w119" },
  { "text": "дворе!", "start": 68.211, "end": 68.63, "line": "l21", "role": "zina", "id": "w120" },
  { "text": "Я", "start": 68.63, "end": 69.531, "line": "l21", "role": "zina", "id": "w121" },
  { "text": "сейчас", "start": 69.531, "end": 69.95, "line": "l21", "role": "zina", "id": "w122" },
  { "text": "милицию", "start": 69.95, "end": 70.69, "line": "l21", "role": "zina", "id": "w123" },
  { "text": "вызову!", "start": 70.69, "end": 71.269, "line": "l21", "role": "zina", "id": "w124" },
  {
    "text": "Зина?..",
    "start": 71.469,
    "end": 72.117,
    "line": "l22",
    "role": "maxim",
    "id": "w125"
  },
  {
    "text": "Зинка,",
    "start": 72.117,
    "end": 73.181,
    "line": "l22",
    "role": "maxim",
    "id": "w126"
  },
  { "text": "ты,", "start": 73.181, "end": 73.939, "line": "l22", "role": "maxim", "id": "w127" },
  { "text": "что", "start": 73.939, "end": 74.337, "line": "l22", "role": "maxim", "id": "w128" },
  { "text": "ли?!", "start": 74.337, "end": 74.736, "line": "l22", "role": "maxim", "id": "w129" },
  {
    "text": "Максим?!",
    "start": 75.036,
    "end": 75.516,
    "line": "l23",
    "role": "zina",
    "id": "w130"
  },
  { "text": "Сорок", "start": 75.516, "end": 76.536, "line": "l23", "role": "zina", "id": "w131" },
  { "text": "лет", "start": 76.536, "end": 76.831, "line": "l23", "role": "zina", "id": "w132" },
  { "text": "ни", "start": 76.831, "end": 77.127, "line": "l23", "role": "zina", "id": "w133" },
  { "text": "слуху", "start": 77.127, "end": 77.607, "line": "l23", "role": "zina", "id": "w134" },
  { "text": "ни", "start": 77.607, "end": 77.903, "line": "l23", "role": "zina", "id": "w135" },
  { "text": "духу,", "start": 77.903, "end": 78.383, "line": "l23", "role": "zina", "id": "w136" },
  { "text": "а", "start": 78.383, "end": 78.679, "line": "l23", "role": "zina", "id": "w137" },
  { "text": "теперь", "start": 78.679, "end": 79.299, "line": "l23", "role": "zina", "id": "w138" },
  {
    "text": "стреляешь",
    "start": 79.299,
    "end": 79.964,
    "line": "l23",
    "role": "zina",
    "id": "w139"
  },
  { "text": "у", "start": 79.964, "end": 80.26, "line": "l23", "role": "zina", "id": "w140" },
  { "text": "меня", "start": 80.26, "end": 80.74, "line": "l23", "role": "zina", "id": "w141" },
  { "text": "под", "start": 80.74, "end": 81.036, "line": "l23", "role": "zina", "id": "w142" },
  {
    "text": "окнами?!",
    "start": 81.036,
    "end": 81.701,
    "line": "l23",
    "role": "zina",
