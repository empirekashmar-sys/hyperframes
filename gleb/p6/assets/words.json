    "text": "Вышел",
    "start": 10.78,
    "end": 11.266,
    "line": "l04",
    "role": "narrator",
    "id": "w19"
  },
  {
    "text": "один",
    "start": 11.266,
    "end": 11.752,
    "line": "l04",
    "role": "narrator",
    "id": "w20"
  },
  {
    "text": "солдат.",
    "start": 11.752,
    "end": 12.238,
    "line": "l04",
    "role": "narrator",
    "id": "w21"
  },
  {
    "text": "Второй.",
    "start": 12.238,
    "end": 12.896,
    "line": "l04",
    "role": "narrator",
    "id": "w22"
  },
  {
    "text": "Пятый.",
    "start": 12.896,
    "end": 13.382,
    "line": "l04",
    "role": "narrator",
    "id": "w23"
  },
  {
    "text": "Двадцатый.",
    "start": 13.382,
    "end": 14.055,
    "line": "l04",
    "role": "narrator",
    "id": "w24"
  },
  { "text": "Да", "start": 14.355, "end": 14.598, "line": "l05", "role": "son_old", "id": "w25" },
  {
    "text": "сколько",
    "start": 14.598,
    "end": 14.994,
    "line": "l05",
    "role": "son_old",
    "id": "w26"
  },
  { "text": "их", "start": 14.994, "end": 15.237, "line": "l05", "role": "son_old", "id": "w27" },
  { "text": "там", "start": 15.237, "end": 15.48, "line": "l05", "role": "son_old", "id": "w28" },
  {
    "text": "помещается?!",
    "start": 15.48,
    "end": 16.332,
    "line": "l05",
    "role": "son_old",
    "id": "w29"
  },
  { "text": "Из", "start": 16.732, "end": 16.944, "line": "l06", "role": "narrator", "id": "w30" },
  {
    "text": "одной",
    "start": 16.944,
    "end": 17.29,
    "line": "l06",
    "role": "narrator",
    "id": "w31"
  },
  {
    "text": "«Калины»",
    "start": 17.29,
    "end": 17.768,
    "line": "l06",
    "role": "narrator",
    "id": "w32"
  },
  {
    "text": "вышел",
    "start": 17.768,
    "end": 18.114,
    "line": "l06",
    "role": "narrator",
    "id": "w33"
  },
  {
    "text": "целый",
    "start": 18.114,
    "end": 18.459,
    "line": "l06",
    "role": "narrator",
    "id": "w34"
  },
  {
    "text": "батальон.",
    "start": 18.459,
    "end": 18.938,
    "line": "l06",
    "role": "narrator",
    "id": "w35"
  },
  { "text": "Это", "start": 19.238, "end": 19.664, "line": "l07", "role": "maxim", "id": "w36" },
  { "text": "ж", "start": 19.664, "end": 19.762, "line": "l07", "role": "maxim", "id": "w37" },
  { "text": "как", "start": 19.762, "end": 20.025, "line": "l07", "role": "maxim", "id": "w38" },
  { "text": "они", "start": 20.025, "end": 20.451, "line": "l07", "role": "maxim", "id": "w39" },
  { "text": "там", "start": 20.451, "end": 20.714, "line": "l07", "role": "maxim", "id": "w40" },
  { "text": "сидели…", "start": 20.714, "end": 21.55, "line": "l07", "role": "maxim", "id": "w41" },
  { "text": "друг", "start": 21.55, "end": 21.813, "line": "l07", "role": "maxim", "id": "w42" },
  { "text": "на", "start": 21.813, "end": 22.075, "line": "l07", "role": "maxim", "id": "w43" },
  { "text": "друге,", "start": 22.075, "end": 22.502, "line": "l07", "role": "maxim", "id": "w44" },
  { "text": "что", "start": 22.502, "end": 22.764, "line": "l07", "role": "maxim", "id": "w45" },
  { "text": "ли?!", "start": 22.764, "end": 23.027, "line": "l07", "role": "maxim", "id": "w46" },
  {
    "text": "Бежим!!!",
    "start": 23.327,
    "end": 24.058,
    "line": "l08",
    "role": "gleb",
    "id": "w47"
  },
  { "text": "Они", "start": 25.558, "end": 25.886, "line": "l09", "role": "narrator", "id": "w48" },
  {
    "text": "спрыгнули",
    "start": 25.886,
    "end": 26.341,
    "line": "l09",
    "role": "narrator",
    "id": "w49"
  },
  { "text": "с", "start": 26.341, "end": 26.416, "line": "l09", "role": "narrator", "id": "w50" },
  {
    "text": "брони",
    "start": 26.416,
    "end": 26.745,
    "line": "l09",
    "role": "narrator",
    "id": "w51"
  },
  { "text": "и", "start": 26.745, "end": 26.947, "line": "l09", "role": "narrator", "id": "w52" },
  {
    "text": "бросились",
    "start": 26.947,
    "end": 27.401,
    "line": "l09",
    "role": "narrator",
    "id": "w53"
  },
  { "text": "во", "start": 27.401, "end": 27.603, "line": "l09", "role": "narrator", "id": "w54" },
  {
    "text": "дворы.",
    "start": 27.603,
    "end": 27.931,
    "line": "l09",
    "role": "narrator",
    "id": "w55"
  },
  { "text": "Не", "start": 28.231, "end": 28.498, "line": "l10", "role": "masha", "id": "w56" },
  {
    "text": "отставайте!",
    "start": 28.498,
    "end": 29.266,
    "line": "l10",
    "role": "masha",
    "id": "w57"
  },
  {
    "text": "Держитесь",
    "start": 29.266,
    "end": 30.219,
    "line": "l10",
    "role": "masha",
    "id": "w58"
  },
  { "text": "за", "start": 30.219, "end": 30.486, "line": "l10", "role": "masha", "id": "w59" },
  { "text": "руки!", "start": 30.486, "end": 30.92, "line": "l10", "role": "masha", "id": "w60" },
  { "text": "Я…", "start": 31.22, "end": 31.573, "line": "l11", "role": "maxim", "id": "w61" },
  { "text": "в", "start": 31.573, "end": 31.706, "line": "l11", "role": "maxim", "id": "w62" },
  {
    "text": "семьдесят",
    "start": 31.706,
    "end": 32.967,
    "line": "l11",
    "role": "maxim",
    "id": "w63"
  },
  {
    "text": "восьмом…",
    "start": 32.967,
    "end": 33.541,
    "line": "l11",
    "role": "maxim",
    "id": "w64"
  },
  {
    "text": "стометровку…",
    "start": 33.541,
    "end": 34.919,
    "line": "l11",
    "role": "maxim",
    "id": "w65"
  },
  { "text": "за", "start": 34.919, "end": 35.751, "line": "l11", "role": "maxim", "id": "w66" },
  { "text": "девять", "start": 35.751, "end": 36.325, "line": "l11", "role": "maxim", "id": "w67" },
  { "text": "секунд", "start": 36.325, "end": 36.899, "line": "l11", "role": "maxim", "id": "w68" },
  { "text": "бегал…", "start": 36.899, "end": 37.473, "line": "l11", "role": "maxim", "id": "w69" },
  { "text": "Дед,", "start": 37.673, "end": 38.036, "line": "l12", "role": "son_old", "id": "w70" },
  { "text": "не", "start": 38.036, "end": 38.525, "line": "l12", "role": "son_old", "id": "w71" },
  {
    "text": "болтай,",
    "start": 38.525,
    "end": 39.114,
    "line": "l12",
    "role": "son_old",
    "id": "w72"
  },
  {
    "text": "беги!",
    "start": 39.114,
    "end": 39.703,
    "line": "l12",
    "role": "son_old",
    "id": "w73"
  },
  { "text": "Сюда!", "start": 40.103, "end": 40.53, "line": "l13", "role": "gleb", "id": "w74" },
  { "text": "Это", "start": 40.53, "end": 41.112, "line": "l13", "role": "gleb", "id": "w75" },
  { "text": "мамин", "start": 41.112, "end": 41.539, "line": "l13", "role": "gleb", "id": "w76" },
  {
    "text": "подъезд!",
    "start": 41.539,
    "end": 41.967,
    "line": "l13",
    "role": "gleb",
    "id": "w77"
  },
  { "text": "Коляску", "start": 43.167, "end": 43.841, "line": "l14", "role": "gleb", "id": "w78" },
  { "text": "к", "start": 43.841, "end": 43.953, "line": "l14", "role": "gleb", "id": "w79" },
  { "text": "двери!", "start": 43.953, "end": 44.764, "line": "l14", "role": "gleb", "id": "w80" },
  {
    "text": "Быстрее!",
    "start": 44.764,
    "end": 45.438,
    "line": "l14",
    "role": "gleb",
    "id": "w81"
  },
  {
    "text": "Мам,",
    "start": 45.738,
    "end": 46.147,
    "line": "l15",
    "role": "son_young",
    "id": "w82"
  },
  { "text": "мне", "start": 46.147, "end": 46.97, "line": "l15", "role": "son_young", "id": "w83" },
  {
    "text": "страшно…",
    "start": 46.97,
    "end": 47.635,
    "line": "l15",
    "role": "son_young",
    "id": "w84"
  },
  { "text": "Я", "start": 47.835, "end": 48.105, "line": "l16", "role": "masha", "id": "w85" },
  { "text": "рядом,", "start": 48.105, "end": 48.543, "line": "l16", "role": "masha", "id": "w86" },
  {
    "text": "зайчик.",
    "start": 48.543,
    "end": 48.981,
    "line": "l16",
    "role": "masha",
    "id": "w87"
  },
  { "text": "Я", "start": 48.981, "end": 49.669, "line": "l16", "role": "masha", "id": "w88" },
  { "text": "рядом.", "start": 49.669, "end": 50.107, "line": "l16", "role": "masha", "id": "w89" },
  { "text": "Глеб,", "start": 50.507, "end": 50.824, "line": "l17", "role": "maxim", "id": "w90" },
  { "text": "ты", "start": 50.824, "end": 51.142, "line": "l17", "role": "maxim", "id": "w91" },
  { "text": "на", "start": 51.142, "end": 51.596, "line": "l17", "role": "maxim", "id": "w92" },
  { "text": "окно.", "start": 51.596, "end": 52.111, "line": "l17", "role": "maxim", "id": "w93" },
  { "text": "Я", "start": 52.111, "end": 52.803, "line": "l17", "role": "maxim", "id": "w94" },
  { "text": "на", "start": 52.803, "end": 53.12, "line": "l17", "role": "maxim", "id": "w95" },
  { "text": "второй", "start": 53.12, "end": 53.636, "line": "l17", "role": "maxim", "id": "w96" },
  { "text": "этаж.", "start": 53.636, "end": 54.151, "line": "l17", "role": "maxim", "id": "w97" },
  { "text": "Дадим", "start": 54.151, "end": 54.954, "line": "l17", "role": "maxim", "id": "w98" },
  { "text": "им", "start": 54.954, "end": 55.271, "line": "l17", "role": "maxim", "id": "w99" },
  {
    "text": "прикурить.",
    "start": 55.271,
    "end": 55.985,
    "line": "l17",
    "role": "maxim",
    "id": "w100"
  },
  {
    "text": "Они",
    "start": 56.385,
    "end": 56.836,
    "line": "l18",
    "role": "soldier1",
    "id": "w101"
  },
  { "text": "в", "start": 56.836, "end": 56.939, "line": "l18", "role": "soldier1", "id": "w102" },
  {
    "text": "подъезде!",
    "start": 56.939,
    "end": 57.715,
    "line": "l18",
    "role": "soldier1",
    "id": "w103"
  },
  {
    "text": "Окружай!",
    "start": 57.715,
    "end": 58.339,
    "line": "l18",
    "role": "soldier1",
    "id": "w104"
  },
  { "text": "Ну", "start": 58.639, "end": 58.921, "line": "l19", "role": "maxim", "id": "w105" },
  {
    "text": "давайте,",
    "start": 58.921,
    "end": 59.558,
    "line": "l19",
    "role": "maxim",
    "id": "w106"
  },
  {
    "text": "сынки!",
    "start": 59.558,
    "end": 60.017,
    "line": "l19",
    "role": "maxim",
    "id": "w107"
  },
  {
    "text": "Подходи",
    "start": 60.017,
    "end": 61.07,
    "line": "l19",
    "role": "maxim",
    "id": "w108"
  },
  { "text": "по", "start": 61.07, "end": 61.353, "line": "l19", "role": "maxim", "id": "w109" },
  {
    "text": "одному!",
    "start": 61.353,
    "end": 61.99,
    "line": "l19",
    "role": "maxim",
    "id": "w110"
  },
  { "text": "И", "start": 62.29, "end": 62.489, "line": "l20", "role": "narrator", "id": "w111" },
