    "start": 5.792,
    "end": 6.247,
    "line": "l02",
    "role": "narrator",
    "id": "w9"
  },
  {
    "text": "выехала",
    "start": 6.247,
    "end": 6.829,
    "line": "l02",
    "role": "narrator",
    "id": "w10"
  },
  { "text": "белая", "start": 6.829, "end": 7.284, "line": "l02", "role": "narrator", "id": "w11" },
  {
    "text": "«Калина».",
    "start": 7.284,
    "end": 7.74,
    "line": "l02",
    "role": "narrator",
    "id": "w12"
  },
  { "text": "Пап…", "start": 8.04, "end": 8.254, "line": "l03", "role": "son_young", "id": "w13" },
