    "start": 2.863,
    "end": 3.546,
    "line": "l01",
    "role": "soldier1",
    "id": "w4"
  },
  {
    "text": "Быстро!",
    "start": 3.546,
    "end": 3.943,
    "line": "l01",
    "role": "soldier1",
    "id": "w5"
  },
  { "text": "Тихо,", "start": 4.143, "end": 4.646, "line": "l02", "role": "gleb", "id": "w6" },
  { "text": "тихо!", "start": 4.646, "end": 5.372, "line": "l02", "role": "gleb", "id": "w7" },
  { "text": "Тут", "start": 5.372, "end": 5.956, "line": "l02", "role": "gleb", "id": "w8" },
  { "text": "дети!", "start": 5.956, "end": 6.459, "line": "l02", "role": "gleb", "id": "w9" },
  {
    "text": "Заткнись!",
    "start": 6.659,
