    "role": "maxim",
    "id": "w42"
  },
  { "text": "старый", "start": 25.147, "end": 25.787, "line": "l08", "role": "maxim", "id": "w43" },
  { "text": "пень.", "start": 25.787, "end": 26.18, "line": "l08", "role": "maxim", "id": "w44" },
