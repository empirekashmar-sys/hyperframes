  },
  { "text": "Мам!", "start": 12.94, "end": 13.317, "line": "l05", "role": "gleb", "id": "w18" },
  { "text": "Вы", "start": 13.317, "end": 13.991, "line": "l05", "role": "gleb", "id": "w19" },
