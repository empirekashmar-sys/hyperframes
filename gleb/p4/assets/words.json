[
  { "text": "На", "start": 1.4, "end": 1.644, "line": "l01", "role": "soldier1", "id": "w0" },
  { "text": "пол!", "start": 1.644, "end": 1.889, "line": "l01", "role": "soldier1", "id": "w1" },
