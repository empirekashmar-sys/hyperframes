    "line": "l03",
    "role": "soldier2",
    "id": "w10"
  },
  { "text": "Лицом", "start": 7.191, "end": 7.981, "line": "l03", "role": "soldier2", "id": "w11" },
  { "text": "к", "start": 7.981, "end": 8.104, "line": "l03", "role": "soldier2", "id": "w12" },
