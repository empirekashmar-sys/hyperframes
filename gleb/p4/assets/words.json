  { "text": "Стоял", "start": 39.313, "end": 39.75, "line": "l13", "role": "gleb", "id": "w66" },
  { "text": "тут.", "start": 39.75, "end": 40.018, "line": "l13", "role": "gleb", "id": "w67" },
  { "text": "Глеб…", "start": 41.418, "end": 41.682, "line": "l14", "role": "masha", "id": "w68" },
  { "text": "что", "start": 41.682, "end": 42.203, "line": "l14", "role": "masha", "id": "w69" },
  { "text": "с", "start": 42.203, "end": 42.302, "line": "l14", "role": "masha", "id": "w70" },
  { "text": "нами", "start": 42.302, "end": 42.73, "line": "l14", "role": "masha", "id": "w71" },
  { "text": "будет?", "start": 42.73, "end": 43.157, "line": "l14", "role": "masha", "id": "w72" },
  { "text": "Всё", "start": 43.457, "end": 43.69, "line": "l15", "role": "gleb", "id": "w73" },
  { "text": "будет", "start": 43.69, "end": 44.067, "line": "l15", "role": "gleb", "id": "w74" },
  { "text": "хорошо.", "start": 44.067, "end": 44.924, "line": "l15", "role": "gleb", "id": "w75" },
  { "text": "Я", "start": 44.924, "end": 45.156, "line": "l15", "role": "gleb", "id": "w76" },
  { "text": "обещаю.", "start": 45.156, "end": 45.824, "line": "l15", "role": "gleb", "id": "w77" },
  { "text": "Ну", "start": 48.424, "end": 48.75, "line": "l16", "role": "maxim", "id": "w78" },
  { "text": "всё,", "start": 48.75, "end": 49.077, "line": "l16", "role": "maxim", "id": "w79" },
  { "text": "суки…", "start": 49.077, "end": 49.607, "line": "l16", "role": "maxim", "id": "w80" },
  { "text": "теперь", "start": 49.607, "end": 50.424, "line": "l16", "role": "maxim", "id": "w81" },
  { "text": "вы", "start": 50.424, "end": 50.751, "line": "l16", "role": "maxim", "id": "w82" },
  { "text": "меня", "start": 50.751, "end": 51.281, "line": "l16", "role": "maxim", "id": "w83" },
  {
    "text": "разозлили.",
