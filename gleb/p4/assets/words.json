    "line": "l09",
    "role": "soldier3",
    "id": "w49"
  },
  {
    "text": "какой-то!",
    "start": 28.958,
    "end": 29.54,
    "line": "l09",
    "role": "soldier3",
    "id": "w50"
  },
  { "text": "Бать…", "start": 31.14, "end": 31.586, "line": "l10", "role": "son_old", "id": "w51" },
  { "text": "где", "start": 31.586, "end": 32.259, "line": "l10", "role": "son_old", "id": "w52" },
  { "text": "дед?", "start": 32.259, "end": 32.705, "line": "l10", "role": "son_old", "id": "w53" },
  { "text": "Не", "start": 32.905, "end": 33.2, "line": "l11", "role": "gleb", "id": "w54" },
  { "text": "знаю.", "start": 33.2, "end": 34.061, "line": "l11", "role": "gleb", "id": "w55" },
  { "text": "Молчи.", "start": 34.061, "end": 34.541, "line": "l11", "role": "gleb", "id": "w56" },
  { "text": "Это", "start": 35.341, "end": 35.779, "line": "l12", "role": "soldier2", "id": "w57" },
  { "text": "ещё", "start": 35.779, "end": 36.218, "line": "l12", "role": "soldier2", "id": "w58" },
  { "text": "что", "start": 36.218, "end": 36.488, "line": "l12", "role": "soldier2", "id": "w59" },
  { "text": "за", "start": 36.488, "end": 36.758, "line": "l12", "role": "soldier2", "id": "w60" },
  {
    "text": "хрень?!",
    "start": 36.758,
    "end": 37.417,
    "line": "l12",
    "role": "soldier2",
    "id": "w61"
  },
  { "text": "Чей", "start": 37.417, "end": 37.687, "line": "l12", "role": "soldier2", "id": "w62" },
  {
    "text": "танк?!",
    "start": 37.687,
    "end": 37.957,
    "line": "l12",
    "role": "soldier2",
    "id": "w63"
  },
  { "text": "Не", "start": 38.257, "end": 38.526, "line": "l13", "role": "gleb", "id": "w64" },
